@model GestionProjetSocota.ViewModels.LoginViewModel

<div style="min-height:80vh; display:flex; align-items:center; justify-content:center;">
  <div style="background:#fff; border-radius:14px; padding:34px 32px; width:340px; box-shadow:0 8px 24px rgba(0,0,0,0.12);">
    <div style="width:44px; height:44px; border-radius:10px; background:#228B22; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:18px; margin:0 auto 14px;">S</div>
    <p style="text-align:center; font-size:16px; font-weight:700; margin:0 0 4px;">Gestion de projet</p>
    <p style="text-align:center; font-size:13px; color:#5F5E5A; margin:0 0 22px;">Connectez-vous à votre espace</p>

    <form asp-action="Login" method="post">
      <div asp-validation-summary="ModelOnly" style="color:red; font-size:13px; margin-bottom:10px;"></div>

      <label>Email</label>
      <input asp-for="Email" type="text" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px; margin-bottom:6px;" />
      <span asp-validation-for="Email" style="color:red; font-size:12px;"></span>

      <label style="display:block; margin-top:10px;">Mot de passe</label>
      <div style="position:relative;">
        <input asp-for="MotDePasse" id="motDePasseInput" type="password" style="width:100%; padding:9px 34px 9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px; margin-bottom:6px; box-sizing:border-box;" />
        <span id="togglePassword" style="position:absolute; right:10px; top:9px; cursor:pointer; font-size:16px; user-select:none;">Voir mdp</span>
      </div>
      <span asp-validation-for="MotDePasse" style="color:red; font-size:12px;"></span>

      <button type="submit" style="width:100%; padding:10px; border:none; border-radius:8px; background:#228B22; color:#fff; font-weight:600; font-size:13px; cursor:pointer; margin-top:14px;">Se connecter</button>
    </form>
  </div>
</div>

<script>
  const toggleIcon = document.getElementById('togglePassword');
  const passwordInput = document.getElementById('motDePasseInput');

  toggleIcon.addEventListener('click', function () {
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      toggleIcon.textContent = 'Cacher mdp';
    } else {
      passwordInput.type = 'password';
      toggleIcon.textContent = 'Voir mdp';
    }
  });
</script>