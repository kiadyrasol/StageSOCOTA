@model GestionProjetSocota.ViewModels.DashboardViewModel

<style>
    .it-manager-page {
        --socota-green: #8BC53F;
        --socota-green-dark: #70A130;
        --warning: #f0ad4e;
        --danger: #dc3545;
    }

    .it-manager-title {
        font-weight: 700;
        margin-bottom: 0.25rem;
        color: var(--socota-green-dark);
    }

    .it-manager-subtitle {
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
    }

    .it-section-title {
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.9rem;
        color: #55604f;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .it-section-title i {
        color: var(--socota-green-dark);
        font-size: 0.78rem;
    }

    .it-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .it-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 26px rgba(0, 0, 0, 0.1);
    }

    .it-stat-card {
        position: relative;
        overflow: hidden;
    }

    .it-stat-card::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 5px;
        background-color: var(--socota-green);
    }

    .it-stat-card.warning::before {
        background-color: var(--warning);
    }

    .it-stat-card.danger::before {
        background-color: var(--danger);
    }

    .it-stat-body {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .it-stat-icon {
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        border-radius: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        background: linear-gradient(135deg, #eef8de, #d7edb2);
        color: var(--socota-green-dark);
    }

    .it-stat-card.warning .it-stat-icon {
        background: linear-gradient(135deg, #fdf1dd, #fadfae);
        color: var(--warning);
    }

    .it-stat-card.danger .it-stat-icon {
        background: linear-gradient(135deg, #fbe6e3, #f7cfc9);
        color: var(--danger);
    }

    .it-stat-label {
        color: #6c757d;
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 0.35rem;
    }

    .it-stat-value {
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1;
    }

    .it-green {
        color: var(--socota-green-dark);
    }

    .it-warning {
        color: var(--warning);
    }

    .it-danger {
        color: var(--danger);
    }

    .it-chart-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
    }

    .it-chart-title {
        font-size: 0.92rem;
        font-weight: 700;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .it-chart-title i {
        color: var(--socota-green-dark);
        font-size: 0.85rem;
    }

    .it-chart {
        height: 240px;
        position: relative;
    }

    .it-date-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .it-date-title {
        font-size: 0.95rem;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .it-date-title i {
        color: var(--socota-green-dark);
        font-size: 0.85rem;
    }

    .it-date-table {
        margin-bottom: 0;
    }

    .it-date-table th {
        font-size: 0.76rem;
        font-weight: 700;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom-width: 1px;
    }

    .it-date-table td {
        font-size: 0.88rem;
        vertical-align: middle;
    }

    .it-date-table tbody tr:hover {
        background-color: #f5f9ee;
    }

    .it-project-link {
        color: inherit;
        text-decoration: none;
        font-weight: 600;
    }

    .it-project-link:hover {
        color: var(--socota-green-dark);
    }

    .it-status {
        background-color: var(--socota-green);
        color: #2b3327;
        font-weight: 600;
        border-radius: 30px;
        padding: 0.35rem 0.75rem;
    }

    .it-empty {
        padding: 1.5rem;
        text-align: center;
        color: #6c757d;
    }

    .it-empty i {
        color: var(--socota-green);
    }

    body[data-bs-theme="dark"] .it-card,
    body[data-bs-theme="dark"] .it-chart-card {
        border: 1px solid #3a3f44;
        box-shadow: none;
    }

    body[data-bs-theme="dark"] .it-stat-label,
    body[data-bs-theme="dark"] .it-date-table th,
    body[data-bs-theme="dark"] .it-manager-subtitle {
        color: #a0a0a0;
    }

    body[data-bs-theme="dark"] .it-date-table tbody tr:hover {
        background-color: #333d31;
    }
</style>


<div class="it-manager-page">

    <!-- TITRE -->

    <div class="mb-4">
        <h1 class="h3 it-manager-title">
            Dashboard IT Manager
        </h1>

        <p class="it-manager-subtitle mb-0">
            Suivi opérationnel de la charge, des risques et des échéances
        </p>
    </div>


    <!-- INDICATEURS -->

    <div class="it-section-title">
        <i class="fas fa-gauge-high"></i>
        Vue opérationnelle
    </div>

    <div class="row g-3 mb-4">

        <!-- PROJETS ACTIFS -->

        <div class="col-md-4">
            <div class="card it-card it-stat-card h-100">

                <div class="card-body it-stat-body">

                    <span class="it-stat-icon">
                        <i class="fas fa-bolt"></i>
                    </span>

                    <div>
                        <div class="it-stat-label">
                            Projets actifs
                        </div>

                        <div class="it-stat-value it-green">
                            @Model.ProjetsActifs
                        </div>
                    </div>

                </div>

            </div>
        </div>


        <!-- EN RETARD -->

        <div class="col-md-4">
            <div class="card it-card it-stat-card danger h-100">

                <div class="card-body it-stat-body">

                    <span class="it-stat-icon">
                        <i class="fas fa-triangle-exclamation"></i>
                    </span>

                    <div>
                        <div class="it-stat-label">
                            Projets en retard
                        </div>

                        <div class="it-stat-value it-danger">
                            @Model.ProjetsEnRetard
                        </div>
                    </div>

                </div>

            </div>
        </div>


        <!-- CRITIQUES -->

        <div class="col-md-4">
            <div class="card it-card it-stat-card warning h-100">

                <div class="card-body it-stat-body">

                    <span class="it-stat-icon">
                        <i class="fas fa-fire"></i>
                    </span>

                    <div>
                        <div class="it-stat-label">
                            Projets critiques
                        </div>

                        <div class="it-stat-value it-warning">
                            @Model.ProjetsCritiques
                        </div>
                    </div>

                </div>

            </div>
        </div>

    </div>


    <!-- GRAPHIQUES -->

    <div class="it-section-title">
        <i class="fas fa-chart-line"></i>
        Analyse des projets
    </div>

    <div class="row g-3 mb-4">

        <!-- CHARGE EQUIPE -->

        <div class="col-md-6">

            <div class="card it-chart-card h-100">

                <div class="card-body">

                    <div class="it-chart-title">
                        <i class="fas fa-users-gear"></i>
                        Charge équipe
                        <span class="text-muted fw-normal">
                            — par responsable IT
                        </span>
                    </div>

                    <div class="it-chart">
                        <canvas id="chartCharge"></canvas>
                    </div>

                </div>

            </div>

        </div>


        <!-- AGING -->

        <div class="col-md-6">

            <div class="card it-chart-card h-100">

                <div class="card-body">

                    <div class="it-chart-title">
                        <i class="fas fa-hourglass-half"></i>
                        Aging des projets
                    </div>

                    <div class="it-chart">
                        <canvas id="chartAging"></canvas>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- DATES DE FIN À VENIR -->

    <div class="card it-card">

        <div class="card-body">

            <div class="it-date-header mb-3">

                <div>
                    <p class="it-date-title">
                        <i class="fas fa-calendar-days"></i>
                        Dates de fin à venir
                    </p>

                    <small class="text-muted">
                        Projets dont la date de fin est prévue dans les 30 prochains jours
                    </small>
                </div>

            </div>


            @if (Model.DatesFinDuMois.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover it-date-table">

                        <thead>
                            <tr>
                                <th>Projet</th>
                                <th>Date de fin</th>
                                <th>Statut</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var projet in Model.DatesFinDuMois)
                            {
                                <tr>

                                    <td>
                                        <a href="/Projet/Details/@projet.Id"
                                           class="it-project-link">

                                            @projet.Nom

                                        </a>
                                    </td>

                                    <td>
                                        @projet.DateFin?.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <span class="badge it-status">
                                            @projet.Statut
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="it-empty">

                    <i class="fas fa-calendar-check mb-2"></i>

                    <div>
                        Aucune date de fin prévue dans les 30 prochains jours.
                    </div>

                </div>
            }

        </div>

    </div>

</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>

<script>

    const chartChargeElement =
        document.getElementById("chartCharge");

    const chartAgingElement =
        document.getElementById("chartAging");


    new Chart(chartChargeElement, {

        type: "bar",

        data: {

            labels: @Html.Raw(Json.Serialize(
                Model.ChargeParOwnerIt.Select(c => c.Label)
            )),

            datasets: [{
                data: @Html.Raw(Json.Serialize(
                    Model.ChargeParOwnerIt.Select(c => c.Valeur)
                )),

                backgroundColor: "#8BC53F",

                borderRadius: 5,

                borderWidth: 0
            }]

        },

        options: {

            maintainAspectRatio: false,

            responsive: true,

            plugins: {

                legend: {
                    display: false
                }

            },

            scales: {

                y: {
                    beginAtZero: true,

                    ticks: {
                        precision: 0
                    }
                }

            }

        }

    });


    new Chart(chartAgingElement, {

        type: "bar",

        data: {

            labels: @Html.Raw(Json.Serialize(
                Model.AgingProjets.Select(a => a.Label)
            )),

            datasets: [{

                data: @Html.Raw(Json.Serialize(
                    Model.AgingProjets.Select(a => a.Valeur)
                )),

                backgroundColor: "#8BC53F",

                borderRadius: 5,

                borderWidth: 0

            }]

        },

        options: {

            maintainAspectRatio: false,

            responsive: true,

            plugins: {

                legend: {
                    display: false
                }

            },

            scales: {

                y: {
                    beginAtZero: true,

                    ticks: {
                        precision: 0
                    }
                }

            }

        }

    });

</script>