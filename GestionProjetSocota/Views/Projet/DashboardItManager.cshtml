@model GestionProjetSocota.ViewModels.DashboardViewModel

<h1 class="h3 mb-3">Dashboard IT Manager</h1>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-success"><div class="card-body">
            <p class="text-success small mb-1">Projets actifs</p>
            <p class="h4 mb-0 text-success">@Model.ProjetsActifs</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card border-danger"><div class="card-body">
            <p class="text-danger small mb-1">En retard</p>
            <p class="h4 mb-0 text-danger">@Model.ProjetsEnRetard</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card border-warning"><div class="card-body">
            <p class="text-warning small mb-1">Projets critiques (High)</p>
            <p class="h4 mb-0">@Model.ProjetsCritiques</p>
        </div></div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <p class="fw-bold small">Charge équipe (par responsable IT)</p>
            <div style="height:220px;"><canvas id="chartCharge"></canvas></div>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <p class="fw-bold small">Aging des projets</p>
            <div style="height:220px;"><canvas id="chartAging"></canvas></div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-header"><b>Deadlines du mois</b></div>
    <div class="card-body">
        @if (Model.DeadlinesDuMois.Any())
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>Projet</th><th>Deadline</th><th>Statut</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.DeadlinesDuMois)
                    {
                        <tr>
                            <td><a href="/Projet/Details/@p.Id">@p.Nom</a></td>
                            <td>@p.Deadline?.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-success">@p.Statut</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">Aucune deadline ce mois-ci.</p>
        }
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
    new Chart(document.getElementById('chartCharge'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.ChargeParOwnerIt.Select(c => c.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.ChargeParOwnerIt.Select(c => c.Valeur))), backgroundColor: '#155D15' }]
        },
        options: { maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });

    new Chart(document.getElementById('chartAging'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.AgingProjets.Select(a => a.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.AgingProjets.Select(a => a.Valeur))), backgroundColor: '#228B22' }]
        },
        options: { maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });
</script>