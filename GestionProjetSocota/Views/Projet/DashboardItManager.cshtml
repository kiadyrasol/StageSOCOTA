@model GestionProjetSocota.ViewModels.DashboardViewModel

<div style="padding:20px;">
    <h2 style="color:#155D15; margin-bottom:18px;">Dashboard IT Manager</h2>

    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:12px; margin-bottom:24px;">
        <div style="background:#E6F4E6; border-radius:10px; padding:14px;">
            <p style="font-size:12px; color:#155D15; margin:0 0 6px;">Projets actifs</p>
            <p style="font-size:22px; font-weight:700; margin:0; color:#155D15;">@Model.ProjetsActifs</p>
        </div>
        <div style="background:#FDEAEA; border-radius:10px; padding:14px;">
            <p style="font-size:12px; color:#a12020; margin:0 0 6px;">En retard</p>
            <p style="font-size:22px; font-weight:700; margin:0; color:#a12020;">@Model.ProjetsEnRetard</p>
        </div>
        <div style="background:#FFF3CD; border-radius:10px; padding:14px;">
            <p style="font-size:12px; color:#8a6d1a; margin:0 0 6px;">Projets critiques (High)</p>
            <p style="font-size:22px; font-weight:700; margin:0; color:#8a6d1a;">@Model.ProjetsCritiques</p>
        </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
        <div style="background:#fff; border:1px solid #E1E0DB; border-radius:12px; padding:16px;">
            <p style="font-size:13px; font-weight:600; margin:0 0 10px;">Charge équipe (par responsable IT)</p>
            <div style="height:220px;">
                <canvas id="chartCharge"></canvas>
            </div>
        </div>
        <div style="background:#fff; border:1px solid #E1E0DB; border-radius:12px; padding:16px;">
            <p style="font-size:13px; font-weight:600; margin:0 0 10px;">Aging des projets</p>
            <div style="height:220px;">
                <canvas id="chartAging"></canvas>
            </div>
        </div>
    </div>

    <div style="background:#fff; border:1px solid #E1E0DB; border-radius:12px; padding:16px;">
        <p style="font-size:13px; font-weight:600; margin:0 0 10px;">Deadlines du mois</p>
        @if (Model.DeadlinesDuMois.Any())
        {
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <tr style="text-align:left; color:#5F5E5A;">
                    <th style="padding:6px;">Projet</th>
                    <th style="padding:6px;">Deadline</th>
                    <th style="padding:6px;">Statut</th>
                </tr>
                @foreach (var p in Model.DeadlinesDuMois)
                {
                    <tr style="border-top:1px solid #E1E0DB;">
                        <td style="padding:6px;"><a href="/Projet/Details/@p.Id" style="color:#228B22; text-decoration:none;">@p.Nom</a></td>
                        <td style="padding:6px;">@p.Deadline?.ToString("dd/MM/yyyy")</td>
                        <td style="padding:6px;">@p.Statut</td>
                    </tr>
                }
            </table>
        }
        else
        {
            <p style="color:#5F5E5A; font-size:13px;">Aucune deadline ce mois-ci.</p>
        }
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
    new Chart(document.getElementById('chartCharge'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.ChargeParOwnerIt.Select(c => c.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.ChargeParOwnerIt.Select(c => c.Valeur))), backgroundColor: '#155D15' }]
        },
        options: { maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });

    new Chart(document.getElementById('chartAging'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.AgingProjets.Select(a => a.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.AgingProjets.Select(a => a.Valeur))), backgroundColor: '#228B22' }]
        },
        options: { maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });
</script>