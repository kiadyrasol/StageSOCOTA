@model GestionProjetSocota.ViewModels.ProjetEditViewModel

<h1 class="h3 mb-3">Modifier le projet</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Ticket ID</label>
                    <input asp-for="TicketId" type="text" class="form-control" />
                    <span asp-validation-for="TicketId" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Référence</label>
                    <input asp-for="Reference" type="text" class="form-control" />
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label">Nom du projet</label>
                    <input asp-for="Nom" type="text" class="form-control" />
                    <span asp-validation-for="Nom" class="text-danger small"></span>
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Unité</label>
                    <select asp-for="Unite" asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.Unite>()" class="form-select"></select>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Département</label>
                    <select asp-for="Departement" asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.Departement>()" class="form-select"></select>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Type</label>
                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.TypeProjet>()" class="form-select"></select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Plateforme</label>
                    <select asp-for="Plateforme" asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.Plateforme>()" class="form-select"></select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Priorité</label>
                    <select asp-for="Priorite" asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.PrioriteProjet>()" class="form-select"></select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold text-success">Statut</label>
                    <select asp-for="Statut" asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.StatutProjet>()" class="form-select border-success"></select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Avancement (%)</label>
                    <input asp-for="PourcentageAvancement" type="number" min="0" max="100" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Owner IT</label>
                    <select asp-for="OwnerItId" asp-items="@(new SelectList(Model.UtilisateursDisponibles, "Id", "Nom"))" class="form-select">
                        <option value="">-- Aucun --</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Power User</label>
                    <select asp-for="PowerUserId" asp-items="@(new SelectList(Model.UtilisateursDisponibles, "Id", "Nom"))" class="form-select">
                        <option value="">-- Aucun --</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Deadline</label>
                    <input asp-for="Deadline" type="date" class="form-control" />
                </div>
            </div>

            <button type="submit" class="btn btn-socota"><i class="fas fa-save"></i> Enregistrer les modifications</button>
        </form>
    </div>
</div>