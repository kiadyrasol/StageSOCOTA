@model List<GestionProjetSocota.Models.Projet>
@{
    var utilisateurs = ViewBag.Utilisateurs as List<GestionProjetSocota.Models.Utilisateur>;
}

<h1 class="h3 mb-3">Recherche multicritères</h1>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Recherche" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small">Unité</label>
                <select name="unite" class="form-select form-select-sm">
                    <option value="">Toutes</option>
                    @foreach (var v in Enum.GetValues<GestionProjetSocota.Models.Unite>())
                    {
                        <option value="@v" selected="@(Context.Request.Query["unite"] == v.ToString())">@v</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Département</label>
                <select name="departement" class="form-select form-select-sm">
                    <option value="">Tous</option>
                    @foreach (var v in Enum.GetValues<GestionProjetSocota.Models.Departement>())
                    {
                        <option value="@v" selected="@(Context.Request.Query["departement"] == v.ToString())">@v</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Statut</label>
                <select name="statut" class="form-select form-select-sm">
                    <option value="">Tous</option>
                    @foreach (var v in Enum.GetValues<GestionProjetSocota.Models.StatutProjet>())
                    {
                        <option value="@v" selected="@(Context.Request.Query["statut"] == v.ToString())">@v</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Type</label>
                <select name="type" class="form-select form-select-sm">
                    <option value="">Tous</option>
                    @foreach (var v in Enum.GetValues<GestionProjetSocota.Models.TypeProjet>())
                    {
                        <option value="@v" selected="@(Context.Request.Query["type"] == v.ToString())">@v</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Responsable IT</label>
                <select name="ownerItId" class="form-select form-select-sm">
                    <option value="">Tous</option>
                    @if (utilisateurs != null)
                    {
                        @foreach (var u in utilisateurs)
                        {
                            <option value="@u.Id" selected="@(Context.Request.Query["ownerItId"] == u.Id.ToString())">@u.Nom</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-socota btn-sm w-100">Filtrer</button>
            </div>
        </form>
        <a href="/Projet/Recherche" class="small text-muted d-inline-block mt-2">Réinitialiser</a>
    </div>
</div>

<div class="mb-2">
    <a href="/Projet/ExporterExcel@(Context.Request.QueryString)" class="btn btn-outline-success btn-sm"><i class="fas fa-file-excel"></i> Export Excel</a>
    <a href="/Projet/ExporterPdf@(Context.Request.QueryString)" class="btn btn-outline-danger btn-sm"><i class="fas fa-file-pdf"></i> Export PDF</a>
</div>

<p class="text-muted small">@Model.Count résultat(s)</p>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Ticket ID</th><th>Nom</th><th>Unité</th><th>Statut</th><th>Owner IT</th></tr>
            </thead>
            <tbody>
                @foreach (var projet in Model)
                {
                    <tr>
                        <td>@projet.TicketId</td>
                        <td><a href="/Projet/Details/@projet.Id">@projet.Nom</a></td>
                        <td>@projet.Unite</td>
                        <td><span class="badge bg-success">@projet.Statut</span></td>
                        <td>@(projet.OwnerIt?.Nom ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>