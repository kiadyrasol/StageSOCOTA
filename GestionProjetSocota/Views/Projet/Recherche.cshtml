@model List<GestionProjetSocota.Models.Projet>

@{
    var utilisateurs =
        ViewBag.Utilisateurs as List<GestionProjetSocota.Models.Utilisateur>;

    var unites =
        ViewBag.Unites as List<GestionProjetSocota.Models.UniteProjet>;

    var departements =
        ViewBag.Departements as List<GestionProjetSocota.Models.DepartementProjet>;

    var types =
        ViewBag.Types as List<GestionProjetSocota.Models.TypeProjetReference>;
}

<h1 class="h3 mb-3">
    Recherche multicritères
</h1>

<div class="card mb-3">

    <div class="card-body">

        <form method="get"
              asp-action="Recherche"
              class="filtres-recherche">

            <!-- Unité -->
            <div class="filtre-item">

                <label class="form-label small" for="unite">
                    Unité
                </label>

                <select id="unite"
                        name="unite"
                        class="form-select form-select-sm">

                    <option value="">
                        Toutes
                    </option>

                    @if (unites != null)
                    {
                        @foreach (var unite in unites)
                        {
                            <option value="@unite.Id"
                                    selected="@(Context.Request.Query["unite"] == unite.Id.ToString())">

                                @unite.Nom

                            </option>
                        }
                    }

                </select>

            </div>


            <!-- Département -->
            <div class="filtre-item">

                <label class="form-label small" for="departement">
                    Département
                </label>

                <select id="departement"
                        name="departement"
                        class="form-select form-select-sm">

                    <option value="">
                        Tous
                    </option>

                    @if (departements != null)
                    {
                        @foreach (var departement in departements)
                        {
                            <option value="@departement.Id"
                                    selected="@(Context.Request.Query["departement"] == departement.Id.ToString())">

                                @departement.Nom

                            </option>
                        }
                    }

                </select>

            </div>


            <!-- Statut -->
            <div class="filtre-item">

                <label class="form-label small" for="statut">
                    Statut
                </label>

                <select id="statut"
                        name="statut"
                        class="form-select form-select-sm">

                    <option value="">
                        Tous
                    </option>

                    @foreach (var statut in Enum.GetValues<GestionProjetSocota.Models.StatutProjet>())
                    {
                        <option value="@statut"
                                selected="@(Context.Request.Query["statut"] == statut.ToString())">

                            @statut

                        </option>
                    }

                </select>

            </div>


            <!-- Type -->
            <div class="filtre-item">

                <label class="form-label small" for="type">
                    Type
                </label>

                <select id="type"
                        name="type"
                        class="form-select form-select-sm">

                    <option value="">
                        Tous
                    </option>

                    @if (types != null)
                    {
                        @foreach (var type in types)
                        {
                            <option value="@type.Id"
                                    selected="@(Context.Request.Query["type"] == type.Id.ToString())">

                                @type.Nom

                            </option>
                        }
                    }

                </select>

            </div>


            <!-- Responsable IT -->
            <div class="filtre-item">

                <label class="form-label small" for="ownerItId">
                    Responsable IT
                </label>

                <select id="ownerItId"
                        name="ownerItId"
                        class="form-select form-select-sm">

                    <option value="">
                        Tous
                    </option>

                    @if (utilisateurs != null)
                    {
                        @foreach (var utilisateur in utilisateurs)
                        {
                            <option value="@utilisateur.Id"
                                    selected="@(Context.Request.Query["ownerItId"] == utilisateur.Id.ToString())">

                                @utilisateur.Nom

                            </option>
                        }
                    }

                </select>

            </div>


            <!-- Action -->
            <div class="filtre-action">

                <button type="submit"
                        class="btn btn-socota btn-sm w-100">

                    <i class="fas fa-filter me-1"></i>
                    Filtrer

                </button>

            </div>

        </form>


        <a asp-action="Recherche"
           class="small text-muted d-inline-block mt-2">

            Réinitialiser

        </a>

    </div>

</div>


<div class="mb-2">

    <a href="/Projet/ExporterExcel@(Context.Request.QueryString)"
       class="btn btn-outline-socota btn-sm">

        <i class="fas fa-file-excel me-1"></i>
        Export Excel

    </a>


    <a href="/Projet/ExporterPdf@(Context.Request.QueryString)"
       class="btn btn-outline-danger btn-sm">

        <i class="fas fa-file-pdf me-1"></i>
        Export PDF

    </a>

</div>


<p class="text-muted small">
    @Model.Count résultat(s)
</p>


<div class="card">

    <div class="card-body p-0">

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Ticket ID</th>
                            <th>Nom</th>
                            <th>Unité</th>
                            <th>Département</th>
                            <th>Type</th>
                            <th>Statut</th>
                            <th>Owner IT</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var projet in Model)
                        {
                            <tr>

                                <td>
                                    @projet.TicketId
                                </td>


                                <td>

                                    <a href="/Projet/Details/@projet.Id">

                                        @projet.Nom

                                    </a>

                                </td>


                                <td>
                                    @(projet.UniteProjet?.Nom ?? "-")
                                </td>


                                <td>
                                    @(projet.DepartementProjet?.Nom ?? "-")
                                </td>


                                <td>
                                    @(projet.TypeProjetReference?.Nom ?? "-")
                                </td>


                                <td>

                                    <span class="badge badge-socota">

                                        @projet.Statut

                                    </span>

                                </td>


                                <td>
                                    @(projet.OwnerIt?.Nom ?? "-")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="p-4 text-center text-muted">

                Aucun projet ne correspond aux critères sélectionnées.

            </div>
        }

    </div>

</div>