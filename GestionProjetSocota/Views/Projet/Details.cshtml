@model GestionProjetSocota.Models.Projet
@{
    var rfc = ViewBag.RFC as GestionProjetSocota.Models.RFC;
    var actions = ViewBag.Actions as List<GestionProjetSocota.Models.ActionProjet>;
    var piecesJointes = ViewBag.PiecesJointes as List<GestionProjetSocota.Models.PieceJointe>;
    var commentaires = ViewBag.Commentaires as List<GestionProjetSocota.Models.Commentaire>;
    var historique = ViewBag.Historique as List<GestionProjetSocota.Models.HistoriqueProjet>;
}

<h1 class="h3 mb-3">@Model.Nom</h1>

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4"><b>Ticket ID :</b> @Model.TicketId</div>
            <div class="col-md-4"><b>Unité :</b> @Model.Unite</div>
            <div class="col-md-4"><b>Département :</b> @Model.Departement</div>
            <div class="col-md-4"><b>Type :</b> @Model.Type</div>
            <div class="col-md-4"><b>Plateforme :</b> @Model.Plateforme</div>
            <div class="col-md-4"><b>Statut :</b> <span class="badge bg-success">@Model.Statut</span></div>
            <div class="col-md-4"><b>Owner IT :</b> @(Model.OwnerIt?.Nom ?? "-")</div>
            <div class="col-md-4"><b>Power User :</b> @(Model.PowerUser?.Nom ?? "-")</div>
            <div class="col-md-4"><b>Avancement :</b> @Model.PourcentageAvancement%</div>
        </div>
        <a href="/Projet/GenererCompteRendu/@Model.Id" class="btn btn-outline-success btn-sm mt-3"><i class="fas fa-magic"></i> Générer un compte-rendu IA</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body d-flex align-items-center justify-content-between">
        <div>
            <p class="text-muted small mb-1">Score de risque</p>
            <span class="badge bg-@ViewBag.CouleurRisque fs-6">@ViewBag.ScoreRisque/100 — @ViewBag.NiveauRisque</span>
        </div>
        <div class="progress" style="width:200px; height:10px;">
            <div class="progress-bar bg-@ViewBag.CouleurRisque" style="width:@(ViewBag.ScoreRisque)%"></div>
        </div>
    </div>
</div>

<!-- RFC -->
<div class="card mb-3">
    <div class="card-header"><b>RFC</b></div>
    <div class="card-body">
        @if (rfc == null)
        {
            <p class="text-muted">Aucun RFC pour ce projet.</p>
            <a href="/RFC/Create?projetId=@Model.Id" class="btn btn-socota btn-sm">+ Créer un RFC</a>
        }
        else
        {
            <p><b>Business Case :</b> @rfc.BusinessCase</p>
            <p><b>ROI estimé :</b> @(rfc.RoiEstime?.ToString("N0") ?? "-")</p>
            <p><b>Champion :</b> @(rfc.Champion?.Nom ?? "-") · <b>Sponsor :</b> @(rfc.Sponsor?.Nom ?? "-")</p>
            <p><b>Statut :</b> @(rfc.EstValide ? "✅ Validé" : "⏳ En attente de validation")</p>

            @if (TempData["Erreur"] != null)
            {
                <div class="alert alert-danger">@TempData["Erreur"]</div>
            }

            @if (!rfc.EstValide)
            {
                <form asp-controller="RFC" asp-action="Valider" method="post">
                    <input type="hidden" name="id" value="@rfc.Id" />
                    <button type="submit" class="btn btn-socota btn-sm">Valider ce RFC</button>
                </form>
            }
            else
            {
                <form asp-controller="RFC" asp-action="AnnulerValidation" method="post">
                    <input type="hidden" name="id" value="@rfc.Id" />
                    <button type="submit" class="btn btn-outline-danger btn-sm">Annuler la validation</button>
                </form>
            }
        }
    </div>
</div>

<!-- Actions -->
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <b>Actions</b>
        <a href="/ActionProjet/Create?projetId=@Model.Id" class="btn btn-socota btn-sm">+ Nouvelle action</a>
    </div>
    <div class="card-body">
        @if (actions != null && actions.Any())
        {
            @foreach (var action in actions)
            {
                <div class="border rounded p-2 mb-2">
                    <p class="mb-1">@action.Description</p>
                    <p class="text-muted small mb-2">
                        @(action.Responsable?.Nom ?? "-") · Échéance : @action.DateEcheance.ToString("dd/MM/yyyy") ·
                        <span class="badge @(action.Statut == GestionProjetSocota.Models.StatutAction.Closed ? "bg-success" : "bg-warning text-dark")">@action.Statut</span>
                    </p>
                    <div class="d-flex gap-1">
                        @if (action.Statut != GestionProjetSocota.Models.StatutAction.Ongoing)
                        {
                            <form asp-controller="ActionProjet" asp-action="ChangerStatut" method="post">
                                <input type="hidden" name="id" value="@action.Id" />
                                <input type="hidden" name="nouveauStatut" value="Ongoing" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">En cours</button>
                            </form>
                        }
                        @if (action.Statut != GestionProjetSocota.Models.StatutAction.Closed)
                        {
                            <form asp-controller="ActionProjet" asp-action="ChangerStatut" method="post">
                                <input type="hidden" name="id" value="@action.Id" />
                                <input type="hidden" name="nouveauStatut" value="Closed" />
                                <button type="submit" class="btn btn-socota btn-sm">Clôturer</button>
                            </form>
                        }
                        <form asp-controller="ActionProjet" asp-action="Delete" method="post">
                            <input type="hidden" name="id" value="@action.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Supprimer</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted mb-0">Aucune action pour ce projet.</p>
        }
    </div>
</div>

<!-- Pièces jointes -->
<div class="card mb-3">
    <div class="card-header"><b>Pièces jointes</b></div>
    <div class="card-body">
        <form asp-controller="PieceJointe" asp-action="Create" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-center flex-wrap mb-3">
            <input type="hidden" name="ProjetId" value="@Model.Id" />
            <input type="file" name="Fichier" class="form-control form-control-sm" style="width:auto;" />
            <select name="Type" class="form-select form-select-sm" style="width:auto;">
                <option value="RFC">RFC</option>
                <option value="MOM">Compte-rendu (MOM)</option>
                <option value="Analyse">Analyse</option>
                <option value="CahierDesCharges">Cahier des charges</option>
                <option value="CaptureEcran">Capture d'écran</option>
                <option value="PlanDeTests">Plan de tests</option>
            </select>
            <button type="submit" class="btn btn-socota btn-sm">Importer</button>
        </form>

        @if (piecesJointes != null && piecesJointes.Any())
        {
            @foreach (var pj in piecesJointes)
            {
                <div class="d-flex justify-content-between align-items-center border rounded p-2 mb-2">
                    <a href="@pj.CheminStockage" target="_blank">@pj.NomFichier</a>
                    <div>
                        <span class="text-muted small me-2">@pj.Type · @pj.DateAjout.ToString("dd/MM/yyyy")</span>
                        <form asp-controller="PieceJointe" asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@pj.Id" />
                            <button type="submit" class="btn btn-link text-danger btn-sm p-0">Supprimer</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted mb-0">Aucune pièce jointe pour ce projet.</p>
        }
    </div>
</div>

<!-- Commentaires -->
<div class="card mb-3">
    <div class="card-header"><b>Commentaires</b></div>
    <div class="card-body">
        <form asp-controller="Commentaire" asp-action="Create" method="post" class="mb-3">
            <input type="hidden" name="ProjetId" value="@Model.Id" />
            <textarea name="Contenu" placeholder="Ajouter un commentaire..." class="form-control mb-2" rows="2"></textarea>
            <button type="submit" class="btn btn-socota btn-sm">Publier</button>
        </form>

        @if (commentaires != null && commentaires.Any())
        {
            @foreach (var c in commentaires)
            {
                <div class="border rounded p-2 mb-2">
                    <p class="fw-bold mb-1">@(c.Auteur?.Nom ?? "Utilisateur inconnu")</p>
                    <p class="mb-1">@c.Contenu</p>
                    <p class="text-muted small mb-0">
                        @c.DatePublication.ToString("dd/MM/yyyy HH:mm")
                        <form asp-controller="Commentaire" asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="btn btn-link text-danger btn-sm p-0 ms-2">Supprimer</button>
                        </form>
                    </p>
                </div>
            }
        }
        else
        {
            <p class="text-muted mb-0">Aucun commentaire pour ce projet.</p>
        }
    </div>
</div>

<!-- Historique des modifications -->
<div class="card mb-3 border">
    <div class="card-header bg-body-tertiary">
        <h5 class="mb-0 fs-6 fw-bold">Historique des modifications</h5>
    </div>
    <div class="card-body">
        @if (historique != null && historique.Any())
        {
            <ul class="list-group list-group-flush">
                @foreach (var h in historique)
                {
                    <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0 border-bottom">
                        <div>
                            <strong>@h.TypeAction</strong> - @h.Detail
                            <br />
                            <small class="text-body-secondary">Par : @(h.Utilisateur?.Nom ?? "Système")</small>
                        </div>
                        <span class="badge bg-secondary">@h.DateAction.ToString("dd/MM/yyyy HH:mm")</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-body-secondary mb-0">Aucun historique disponible.</p>
        }
    </div>
</div>

<a href="/Projet" class="text-muted"><i class="fas fa-arrow-left"></i> Retour à la liste</a>