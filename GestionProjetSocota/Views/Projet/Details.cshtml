
@model GestionProjetSocota.Models.Projet

@{
    var rfc = ViewBag.RFC as GestionProjetSocota.Models.RFC;
    var actions = ViewBag.Actions as List<GestionProjetSocota.Models.ActionProjet>;
    var piecesJointes = ViewBag.PiecesJointes as List<GestionProjetSocota.Models.PieceJointe>;
    var commentaires = ViewBag.Commentaires as List<GestionProjetSocota.Models.Commentaire>;
    var historique = ViewBag.Historique as List<GestionProjetSocota.Models.HistoriqueProjet>;

    var scoreRisque = ViewBag.ScoreRisque;
    var couleurRisque = ViewBag.CouleurRisque as string;
    var niveauRisque = ViewBag.NiveauRisque as string;

    var risqueClasse = couleurRisque == "success"
        ? "badge-risque-socota"
        : $"bg-{couleurRisque}";

    var progressRisqueClasse = couleurRisque == "success"
        ? "progress-risque-socota"
        : $"bg-{couleurRisque}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.Nom</h1>
        <p class="text-muted mb-0">
            Détails et suivi du projet
        </p>
    </div>

    <div class="d-flex gap-2">
        @if (User.IsInRole("Administrateur") || User.IsInRole("ChefDeProjet"))
        {
            <a href="/Projet/ChangerStatut/@Model.Id" class="btn btn-outline-socota">
                <i class="fas fa-exchange-alt me-1"></i>
                Statut
            </a>

            <a href="/Projet/Edit/@Model.Id" class="btn btn-outline-primary">
                <i class="fas fa-edit me-1"></i>
                Modifier
            </a>
        }

        <a href="/Projet" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>
            Retour
        </a>
    </div>
</div>

@if (Model.PowerUser != null)
{
    @if (Model.ValidePowerUser)
    {
        <div class="alert d-flex align-items-center mb-4"
             style="border-left: 6px solid #8BC53F; font-size: 1.05rem; background-color: rgba(139,197,63,0.1);">

            <i class="fas fa-check-circle fa-2x me-3" style="color:#8BC53F;"></i>

            <div>
                <strong>Projet validé par le Power User</strong>

                @if (Model.DateValidationPowerUser.HasValue)
                {
                    <div class="text-muted small">
                        Validé le @Model.DateValidationPowerUser.Value.ToString("dd/MM/yyyy à HH:mm")
                        par @Model.PowerUser.Nom
                    </div>
                }
            </div>

        </div>
    }
    else
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between mb-4"
             style="border-left: 6px solid #ffc107; font-size: 1.05rem;">

            <div class="d-flex align-items-center">

                <i class="fas fa-exclamation-triangle fa-2x me-3"></i>

                <div>
                    <strong>Validation du Power User requise</strong>

                    <div class="small">
                        Le développement ne peut pas démarrer tant que
                        @Model.PowerUser.Nom n'a pas validé ce projet.
                    </div>
                </div>

            </div>

            @if (User.Identity != null && User.Identity.Name == Model.PowerUser.NomADUtilisateur)
            {
                <form asp-action="ValiderPowerUser" method="post" class="ms-3">

                    <input type="hidden" name="id" value="@Model.Id" />

                    <button type="submit" class="btn btn-socota btn-lg">
                        <i class="fas fa-check me-1"></i>
                        Valider ce projet
                    </button>

                </form>
            }

        </div>
    }
}

<!-- INFORMATIONS DU PROJET -->

<div class="card mb-4">
    <div class="card-header">
        <h2 class="h6 mb-0 fw-bold">
            Informations du projet
        </h2>
    </div>

    <div class="card-body">

        <!-- UNITÉ EN PREMIER -->

        <div class="mb-4 p-3 border rounded">
            <span class="detail-label">
                Unité
            </span>

            <span class="detail-value fs-5 fw-semibold">
                @(Model.UniteProjet?.Nom ?? "-")
            </span>
        </div>

        <!-- CLASSIFICATION -->

        <div class="mb-4">

            <h3 class="h6 fw-bold mb-3">
                Classification
            </h3>

            <div class="table-responsive">

                <table class="table table-sm table-bordered align-middle mb-0">

                    <tbody>

                        <tr>
                            <th style="width: 25%;">
                                Département
                            </th>

                            <td>
                                @(Model.DepartementProjet?.Nom ?? "-")
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Type
                            </th>

                            <td>
                                @(Model.TypeProjetReference?.Nom ?? "-")
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Plateforme
                            </th>

                            <td>
                                @(Model.PlateformeProjet?.Nom ?? "-")
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Priorité
                            </th>

                            <td>
                                @Model.Priorite
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

        <!-- AUTRES INFORMATIONS -->

        <div class="row g-4">

            <div class="col-md-4">
                <span class="detail-label">
                    Ticket ID
                </span>

                <span class="detail-value">
                    @Model.TicketId
                </span>
            </div>

            <div class="col-md-4">
                <span class="detail-label">
                    Référence
                </span>

                <span class="detail-value">
                    @(string.IsNullOrWhiteSpace(Model.Reference)
                        ? "-"
                        : Model.Reference)
                </span>
            </div>

            <div class="col-md-4">
                <span class="detail-label">
                    Statut
                </span>


                <span class="badge bg-socota">
                    @Model.Statut
                </span>
            </div>

            <div class="col-md-4">
                <span class="detail-label">
                    Owner IT
                </span>

                <span class="detail-value">
                    @(Model.OwnerIt?.Nom ?? "-")
                </span>
            </div>

            <div class="col-md-4">
                <span class="detail-label">
                    Power User
                </span>

                <span class="detail-value">
                    @(Model.PowerUser?.Nom ?? "-")
                </span>
            </div>

            <div class="col-md-4">
                <span class="detail-label">
                    Avancement
                </span>

                <div class="project-progress">
                    <div class="progress">

                        <div class="progress-bar progress-bar-socota"
                             role="progressbar"
                             style="width: @Model.PourcentageAvancement%">

                            @Model.PourcentageAvancement%

                        </div>

                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <span class="detail-label">
                    Date de début
                </span>

                @if (Model.DateDebut.HasValue)
                {
                    <span class="detail-value">
                        @Model.DateDebut.Value.ToString("dd/MM/yyyy")
                    </span>
                }
                else
                {
                    <span class="text-muted">
                        Non définie
                    </span>
                }
            </div>

            <div class="col-md-4">
                <span class="detail-label">
                    Date de fin
                </span>

                @if (Model.DateFin.HasValue)
                {
                    var dateFinDepassee =
                        Model.DateFin.Value.Date < DateTime.Now.Date &&
                        Model.Statut != StatutProjet.Closed &&
                        Model.Statut != StatutProjet.Cancelled;

                    <span class="detail-value @(dateFinDepassee ? "text-danger fw-semibold" : "")">
                        @Model.DateFin.Value.ToString("dd/MM/yyyy")
                    </span>
                }
                else
                {
                    <span class="text-muted">
                        Non définie
                    </span>
                }
            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="project-description mt-4">

                <span class="detail-label">
                    Description
                </span>

                <p class="mb-0">
                    @Model.Description
                </p>

            </div>
        }

        <div class="mt-4">

            <a href="/Projet/GenererCompteRendu/@Model.Id"
               class="btn btn-outline-socota btn-sm">

                <i class="fas fa-magic me-1"></i>
                Générer un compte-rendu IA

            </a>

        </div>

    </div>
</div>


<!-- SCORE DE RISQUE -->

<div class="card mb-4">

    <div class="card-header">

        <h2 class="h6 mb-0 fw-bold">
            Score de risque
        </h2>

    </div>

    <div class="card-body">

        <div class="risk-summary">

            <div>

                <span class="detail-label">
                    Niveau de risque
                </span>

                <span class="badge @risqueClasse fs-6">
                    @scoreRisque/100 — @niveauRisque
                </span>

            </div>

            <div class="risk-progress">

                <div class="progress">

                    <div class="progress-bar @progressRisqueClasse"
                         role="progressbar"
                         style="width: @scoreRisque%">
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- RFC -->

<div class="card mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h2 class="h6 mb-0 fw-bold">
            RFC
        </h2>

    </div>

    <div class="card-body">

        @if (rfc == null)
        {
            <div class="empty-state">

                <i class="fas fa-file-circle-question"></i>

                <p class="mb-3">
                    Aucun RFC pour ce projet.
                </p>

                <a href="/RFC/Create?projetId=@Model.Id"
                   class="btn btn-socota btn-sm">

                    <i class="fas fa-plus me-1"></i>
                    Créer un RFC

                </a>

            </div>
        }
        else
        {
            <div class="row g-4">

                <div class="col-md-6">

                    <span class="detail-label">
                        Business Case
                    </span>

                    <p class="mb-0">
                        @rfc.BusinessCase
                    </p>

                </div>

                <div class="col-md-3">

                    <span class="detail-label">
                        ROI estimé
                    </span>

                    <p class="mb-0 fw-semibold">
                        @(rfc.RoiEstime?.ToString("N0") ?? "-")
                    </p>

                </div>

                <div class="col-md-3">

                    <span class="detail-label">
                        Validation
                    </span>

                    @if (rfc.EstValide)
                    {
                        <!-- CORRECTION : badge-socota -> bg-socota -->
                        <span class="badge bg-socota">
                            Validé
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            En attente
                        </span>
                    }

                </div>

                <div class="col-md-6">

                    <span class="detail-label">
                        Champion
                    </span>

                    <p class="mb-0">
                        @(rfc.Champion?.Nom ?? "-")
                    </p>

                </div>

                <div class="col-md-6">

                    <span class="detail-label">
                        Sponsor
                    </span>

                    <p class="mb-0">
                        @(rfc.Sponsor?.Nom ?? "-")
                    </p>

                </div>

            </div>

            @if (TempData["Erreur"] != null)
            {
                <div class="alert alert-danger mt-4">
                    @TempData["Erreur"]
                </div>
            }

            <div class="mt-4">

                @if (!rfc.EstValide)
                {
                    <form asp-controller="RFC"
                          asp-action="Valider"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@rfc.Id" />

                        <button type="submit"
                                class="btn btn-socota btn-sm">

                            <i class="fas fa-check me-1"></i>
                            Valider ce RFC

                        </button>

                    </form>
                }
                else
                {
                    <form asp-controller="RFC"
                          asp-action="AnnulerValidation"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@rfc.Id" />

                        <button type="submit"
                                class="btn btn-outline-danger btn-sm">

                            <i class="fas fa-rotate-left me-1"></i>
                            Annuler la validation

                        </button>

                    </form>
                }

            </div>
        }

    </div>

</div>


<!-- ACTIONS -->

<div class="card mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h2 class="h6 mb-0 fw-bold">
            Actions
        </h2>

        @if (User.IsInRole("Administrateur") || User.IsInRole("ChefDeProjet"))
        {
            <a href="/ActionProjet/Create?projetId=@Model.Id"
               class="btn btn-socota btn-sm">

                <i class="fas fa-plus me-1"></i>
                Nouvelle action

            </a>
        }

    </div>

    <div class="card-body">

        @if (actions != null && actions.Any())
        {
            @foreach (var action in actions)
            {
                <div class="project-action d-flex justify-content-between align-items-center mb-3 p-2 border rounded">

                    <div class="project-action-content">

                        <p class="mb-1 fw-semibold">
                            @action.Description
                        </p>

                        <p class="text-muted small mb-0">

                            <i class="fas fa-user me-1"></i>
                            @(action.Responsable?.Nom ?? "-")

                            <span class="mx-1">
                                ·
                            </span>

                            <i class="fas fa-calendar me-1"></i>
                            @action.DateEcheance.ToString("dd/MM/yyyy")

                        </p>

                    </div>

                    <div class="project-action-status">

                        <!-- CORRECTION : badge-socota -> bg-socota -->
                        <span class="badge @(action.Statut == GestionProjetSocota.Models.StatutAction.Closed ? "bg-socota" : "bg-warning text-dark")">
                            @action.Statut
                        </span>

                    </div>

                    <div class="project-action-buttons d-flex gap-1">

                        @if (User.IsInRole("Administrateur") || User.IsInRole("ChefDeProjet"))
                        {
                            @if (action.Statut != GestionProjetSocota.Models.StatutAction.Ongoing)
                            {
                                <form asp-controller="ActionProjet"
                                      asp-action="ChangerStatut"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@action.Id" />

                                    <input type="hidden"
                                           name="nouveauStatut"
                                           value="Ongoing" />

                                    <button type="submit"
                                            class="btn btn-outline-secondary btn-sm">

                                        En cours

                                    </button>

                                </form>
                            }

                            @if (action.Statut != GestionProjetSocota.Models.StatutAction.Closed)
                            {
                                <form asp-controller="ActionProjet"
                                      asp-action="ChangerStatut"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@action.Id" />

                                    <input type="hidden"
                                           name="nouveauStatut"
                                           value="Closed" />

                                    <button type="submit"
                                            class="btn btn-socota btn-sm">

                                        Clôturer

                                    </button>

                                </form>
                            }

                            <form asp-controller="ActionProjet"
                                  asp-action="Delete"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@action.Id" />

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">

                                    Supprimer

                                </button>

                            </form>
                        }

                    </div>

                </div>
            }
        }
        else
        {
            <div class="empty-state">

                <i class="fas fa-list-check"></i>

                <p class="mb-0">
                    Aucune action pour ce projet.
                </p>

            </div>
        }

    </div>

</div>


<!-- PIÈCES JOINTES -->

<div class="card mb-4">

    <div class="card-header">

        <h2 class="h6 mb-0 fw-bold">
            <i class="fas fa-paperclip me-2"></i>
            Pièces jointes
        </h2>

    </div>

    <div class="card-body">

        <form asp-controller="PieceJointe"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data"
              class="attachment-form mb-4">

            <input type="hidden"
                   name="ProjetId"
                   value="@Model.Id" />

            <div class="mb-3">

                <label class="form-label small fw-semibold">
                    Fichier
                </label>

                <input type="file"
                       name="Fichier"
                       class="form-control form-control-sm" />

            </div>

            <div class="mb-3">

                <label class="form-label small fw-semibold">
                    Type
                </label>

                <select name="Type"
                        class="form-select form-select-sm">

                    <option value="RFC">
                        RFC
                    </option>

                    <option value="MOM">
                        Compte-rendu (MOM)
                    </option>

                    <option value="Analyse">
                        Analyse
                    </option>

                    <option value="CahierDesCharges">
                        Cahier des charges
                    </option>

                    <option value="CaptureEcran">
                        Capture d'écran
                    </option>

                    <option value="PlanDeTests">
                        Plan de tests
                    </option>

                </select>

            </div>

            <div class="attachment-submit">

                <button type="submit"
                        class="btn btn-socota btn-sm">

                    <i class="fas fa-upload me-1"></i>
                    Importer

                </button>

            </div>

        </form>

        @if (piecesJointes != null && piecesJointes.Any())
        {
            foreach (var pj in piecesJointes)
            {
                <div class="attachment-item d-flex justify-content-between align-items-center mb-2 p-2 border rounded">

                    <div>

                        <div class="fw-semibold">

                            <i class="fas fa-paperclip me-1"></i>

                            @pj.NomFichier

                        </div>

                        <div class="text-muted small mt-1">

                            @pj.Type
                            ·
                            @pj.DateAjout.ToString("dd/MM/yyyy HH:mm")

                        </div>

                    </div>

                    <div class="d-flex gap-2">

                        <a asp-controller="PieceJointe"
                           asp-action="Download"
                           asp-route-id="@pj.Id"
                           class="btn btn-sm btn-outline-primary">

                            <i class="fas fa-download me-1"></i>
                            Télécharger

                        </a>

                        <form asp-controller="PieceJointe"
                              asp-action="Delete"
                              method="post"
                              class="d-inline">

                            <input type="hidden"
                                   name="id"
                                   value="@pj.Id" />

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger">

                                <i class="fas fa-trash me-1"></i>
                                Supprimer

                            </button>

                        </form>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="empty-state text-center py-3">

                <i class="fas fa-paperclip fa-2x mb-2"></i>

                <p class="mb-0">
                    Aucune pièce jointe pour ce projet.
                </p>

            </div>
        }

    </div>

</div>


<!-- COMMENTAIRES -->

<div class="card mb-4">

    <div class="card-header">

        <h2 class="h6 mb-0 fw-bold">
            Commentaires
        </h2>

    </div>

    <div class="card-body">

        <form asp-controller="Commentaire"
              asp-action="Create"
              method="post"
              class="mb-4">

            <input type="hidden"
                   name="ProjetId"
                   value="@Model.Id" />

            <textarea name="Contenu"
                      placeholder="Ajouter un commentaire..."
                      class="form-control mb-2"
                      rows="3"></textarea>

            <button type="submit"
                    class="btn btn-socota btn-sm">

                <i class="fas fa-paper-plane me-1"></i>
                Publier

            </button>

        </form>

        @if (commentaires != null && commentaires.Any())
        {
            foreach (var commentaire in commentaires)
            {
                <div class="comment-item mb-3 p-2 border rounded">

                    <div class="d-flex justify-content-between">

                        <strong>
                            @(commentaire.Auteur?.Nom ?? "Utilisateur inconnu")
                        </strong>

                        <small class="text-muted">
                            @commentaire.DatePublication.ToString("dd/MM/yyyy HH:mm")
                        </small>

                    </div>

                    <p class="mb-2 mt-2">
                        @commentaire.Contenu
                    </p>

                    <form asp-controller="Commentaire"
                          asp-action="Delete"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@commentaire.Id" />

                        <button type="submit"
                                class="btn btn-link text-danger btn-sm p-0">

                            Supprimer

                        </button>

                    </form>

                </div>
            }
        }
        else
        {
            <div class="empty-state">

                <i class="fas fa-comments"></i>

                <p class="mb-0">
                    Aucun commentaire pour ce projet.
                </p>

            </div>
        }

    </div>

</div>


<!-- HISTORIQUE -->

<div class="card mb-4">

    <div class="card-header">

        <h2 class="h6 mb-0 fw-bold">
            Historique des modifications
        </h2>

    </div>

    <div class="card-body">

        @if (historique != null && historique.Any())
        {
            <div class="history-list">

                @foreach (var item in historique)
                {
                    <div class="history-item d-flex justify-content-between align-items-center mb-2">

                        <div>

                            <div class="fw-semibold">
                                @item.TypeAction
                            </div>

                            <div>
                                @item.Detail
                            </div>

                            <small class="text-muted">

                                Par :
                                @(item.Utilisateur?.Nom ?? "Système")

                            </small>

                        </div>

                        <span class="badge bg-secondary">

                            @item.DateAction.ToString("dd/MM/yyyy HH:mm")

                        </span>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-state">

                <i class="fas fa-clock-rotate-left"></i>

                <p class="mb-0">
                    Aucun historique disponible.
                </p>

            </div>
        }

    </div>

</div>

