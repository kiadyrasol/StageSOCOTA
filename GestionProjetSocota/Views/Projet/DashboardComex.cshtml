@model GestionProjetSocota.ViewModels.DashboardViewModel

<div style="padding:20px;">
    <h2 style="color:#155D15; margin-bottom:18px;">Dashboard COMEX</h2>

    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:12px; margin-bottom:24px;">
        <div style="background:#FAFAF8; border-radius:10px; padding:14px;">
            <p style="font-size:12px; color:#5F5E5A; margin:0 0 6px;">Total projets</p>
            <p style="font-size:22px; font-weight:700; margin:0;">@Model.TotalProjets</p>
        </div>
        <div style="background:#E6F4E6; border-radius:10px; padding:14px;">
            <p style="font-size:12px; color:#155D15; margin:0 0 6px;">Actifs</p>
            <p style="font-size:22px; font-weight:700; margin:0; color:#155D15;">@Model.ProjetsActifs</p>
        </div>
        <div style="background:#FDEAEA; border-radius:10px; padding:14px;">
            <p style="font-size:12px; color:#a12020; margin:0 0 6px;">En retard</p>
            <p style="font-size:22px; font-weight:700; margin:0; color:#a12020;">@Model.ProjetsEnRetard</p>
        </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
        <div style="background:#fff; border:1px solid #E1E0DB; border-radius:12px; padding:16px;">
            <p style="font-size:13px; font-weight:600; margin:0 0 10px;">Répartition par unité</p>
            <canvas id="chartUnite"></canvas>
        </div>
        <div style="background:#fff; border:1px solid #E1E0DB; border-radius:12px; padding:16px;">
            <p style="font-size:13px; font-weight:600; margin:0 0 10px;">Répartition par département</p>
            <canvas id="chartDept"></canvas>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
    new Chart(document.getElementById('chartUnite'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.RepartitionParUnite.Select(u => u.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.RepartitionParUnite.Select(u => u.Valeur))), backgroundColor: ['#228B22', '#5F5E5A', '#E1E0DB'] }]
        }
    });

    new Chart(document.getElementById('chartDept'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.RepartitionParDepartement.Select(d => d.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.RepartitionParDepartement.Select(d => d.Valeur))), backgroundColor: '#228B22' }]
        },
        options: { plugins: { legend: { display: false } } }
    });
</script>