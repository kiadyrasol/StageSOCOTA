@model GestionProjetSocota.ViewModels.DashboardViewModel

<style>
    .comex-page {
        --socota-green: #8BC53F;
        --socota-green-dark: #70A130;
        --comex-warning: #f0ad4e;
        --comex-danger: #dc3545;
    }

    .comex-title {
        font-weight: 700;
        margin-bottom: 0.25rem;
        color: var(--socota-green-dark);
    }

    .comex-subtitle {
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
    }

    .comex-section-title {
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.9rem;
        color: #55604f;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .comex-section-title i {
        color: var(--socota-green-dark);
        font-size: 0.78rem;
    }

    .comex-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .comex-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 26px rgba(0, 0, 0, 0.1);
    }

    .comex-health-card {
        position: relative;
        overflow: hidden;
    }

    .comex-health-card::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 5px;
        background-color: var(--socota-green);
    }

    .comex-health-card.warning::before {
        background-color: var(--comex-warning);
    }

    .comex-health-card.danger::before {
        background-color: var(--comex-danger);
    }

    .comex-health-body {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .comex-health-icon {
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        border-radius: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        background: linear-gradient(135deg, #eef8de, #d7edb2);
        color: var(--socota-green-dark);
    }

    .comex-health-card.warning .comex-health-icon {
        background: linear-gradient(135deg, #fdf1dd, #fadfae);
        color: var(--comex-warning);
    }

    .comex-health-card.danger .comex-health-icon {
        background: linear-gradient(135deg, #fbe6e3, #f7cfc9);
        color: var(--comex-danger);
    }

    .comex-label {
        color: #6c757d;
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 0.35rem;
    }

    .comex-value {
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1;
    }

    .comex-green {
        color: var(--socota-green-dark);
    }

    .comex-warning {
        color: var(--comex-warning);
    }

    .comex-danger {
        color: var(--comex-danger);
    }

    .comex-chart-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
    }

    .comex-chart-title {
        font-size: 0.92rem;
        font-weight: 700;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .comex-chart-title i {
        color: var(--socota-green-dark);
        font-size: 0.85rem;
    }

    .comex-chart {
        height: 240px;
        position: relative;
    }

    body[data-bs-theme="dark"] .comex-card,
    body[data-bs-theme="dark"] .comex-chart-card {
        box-shadow: none;
        border: 1px solid #3a3f44;
    }

    body[data-bs-theme="dark"] .comex-label,
    body[data-bs-theme="dark"] .comex-subtitle {
        color: #a0a0a0;
    }
</style>

<div class="comex-page">

    <div class="mb-4">
        <h1 class="h3 comex-title">
            Dashboard COMEX
        </h1>

        <p class="comex-subtitle mb-0">
            Vue synthétique de la santé du portefeuille projets
        </p>
    </div>


    <!-- PORTFOLIO HEALTH -->

    <div class="comex-section-title">
        <i class="fas fa-heart-pulse"></i>
        Portfolio Health
    </div>

    <div class="row g-3 mb-4">

        <!-- Vert -->
        <div class="col-md-4">
            <div class="card comex-card comex-health-card h-100">
                <div class="card-body comex-health-body">

                    <span class="comex-health-icon">
                        <i class="fas fa-check"></i>
                    </span>

                    <div>
                        <div class="comex-label">
                            Délai respecté
                        </div>

                        <div class="comex-value comex-green">
                            @Model.PortfolioVert
                        </div>
                    </div>

                </div>
            </div>
        </div>


        <!-- Orange -->
        <div class="col-md-4">
            <div class="card comex-card comex-health-card warning h-100">
                <div class="card-body comex-health-body">

                    <span class="comex-health-icon">
                        <i class="fas fa-clock"></i>
                    </span>

                    <div>
                        <div class="comex-label">
                            Retard inférieur à 30 jours
                        </div>

                        <div class="comex-value comex-warning">
                            @Model.PortfolioOrange
                        </div>
                    </div>

                </div>
            </div>
        </div>


        <!-- Rouge -->
        <div class="col-md-4">
            <div class="card comex-card comex-health-card danger h-100">
                <div class="card-body comex-health-body">

                    <span class="comex-health-icon">
                        <i class="fas fa-triangle-exclamation"></i>
                    </span>

                    <div>
                        <div class="comex-label">
                            Retard supérieur à 30 jours
                        </div>

                        <div class="comex-value comex-danger">
                            @Model.PortfolioRouge
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- GRAPHIQUES -->

    <div class="row g-3">

        <!-- TYPE -->
        <div class="col-md-6">

            <div class="card comex-chart-card h-100">

                <div class="card-body">

                    <div class="comex-chart-title">
                        <i class="fas fa-chart-pie"></i>
                        Répartition In House / Outsourced
                    </div>

                    <div class="comex-chart">
                        <canvas id="chartType"></canvas>
                    </div>

                </div>

            </div>

        </div>


        <!-- PLATEFORME -->
        <div class="col-md-6">

            <div class="card comex-chart-card h-100">

                <div class="card-body">

                    <div class="comex-chart-title">
                        <i class="fas fa-chart-column"></i>
                        Répartition par plateforme
                    </div>

                    <div class="comex-chart">
                        <canvas id="chartPlateforme"></canvas>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>

<script>
    const chartTypeElement = document.getElementById("chartType");
    const chartPlateformeElement = document.getElementById("chartPlateforme");

    new Chart(chartTypeElement, {
        type: "doughnut",
        data: {
            labels: @Html.Raw(Json.Serialize(
                Model.RepartitionParType.Select(t => t.Label)
            )),
            datasets: [{
                data: @Html.Raw(Json.Serialize(
                    Model.RepartitionParType.Select(t => t.Valeur)
                )),
                backgroundColor: [
                    "#8BC53F",
                    "#5F5E5A"
                ],
                borderWidth: 0
            }]
        },
        options: {
            maintainAspectRatio: false,
            responsive: true,
            plugins: {
                legend: {
                    position: "bottom"
                }
            }
        }
    });


    new Chart(chartPlateformeElement, {
        type: "bar",
        data: {
            labels: @Html.Raw(Json.Serialize(
                Model.RepartitionParPlateforme.Select(p => p.Label)
            )),
            datasets: [{
                data: @Html.Raw(Json.Serialize(
                    Model.RepartitionParPlateforme.Select(p => p.Valeur)
                )),
                backgroundColor: "#8BC53F",
                borderRadius: 5,
                borderWidth: 0
            }]
        },
        options: {
            maintainAspectRatio: false,
            responsive: true,
            plugins: {
                legend: {
                    display: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
</script>