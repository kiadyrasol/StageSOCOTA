@model GestionProjetSocota.ViewModels.DashboardViewModel

<h1 class="h3 mb-3">Dashboard COMEX</h1>

<p class="fw-bold small">Portfolio Health</p>
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-success"><div class="card-body">
            <p class="text-success small mb-1">délai respecté</p>
            <p class="h4 mb-0 text-success">@Model.PortfolioVert</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card border-warning"><div class="card-body">
            <p class="text-warning small mb-1">retard &lt; 30</p>
            <p class="h4 mb-0">@Model.PortfolioOrange</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card border-danger"><div class="card-body">
            <p class="text-danger small mb-1">retard &gt; 30j</p>
            <p class="h4 mb-0 text-danger">@Model.PortfolioRouge</p>
        </div></div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <p class="fw-bold small">Répartition In House / Outsourced</p>
            <div style="height:220px;"><canvas id="chartType"></canvas></div>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <p class="fw-bold small">Répartition par plateforme</p>
            <div style="height:220px;"><canvas id="chartPlateforme"></canvas></div>
        </div></div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
    new Chart(document.getElementById('chartType'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.RepartitionParType.Select(t => t.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.RepartitionParType.Select(t => t.Valeur))), backgroundColor: ['#228B22', '#5F5E5A'] }]
        },
        options: { maintainAspectRatio: false }
    });

    new Chart(document.getElementById('chartPlateforme'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.RepartitionParPlateforme.Select(p => p.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.RepartitionParPlateforme.Select(p => p.Valeur))), backgroundColor: '#228B22' }]
        },
        options: { maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });
</script>