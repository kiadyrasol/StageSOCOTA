@model GestionProjetSocota.ViewModels.DashboardViewModel

<div style="padding:20px;">
    <h2 style="color:#155D15; margin-bottom:18px;">Dashboard COMEX</h2>

    <p style="font-size:13px; font-weight:600; margin:0 0 10px;">Portfolio Health</p>
    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:12px; margin-bottom:24px;">
        <div style="background:#E6F4E6; border-radius:10px; padding:14px;">
            <p style="font-size:12px; color:#155D15; margin:0 0 6px;">(délai respecté)</p>
            <p style="font-size:22px; font-weight:700; margin:0; color:#155D15;">@Model.PortfolioVert</p>
        </div>
        <div style="background:#FFF3CD; border-radius:10px; padding:14px;">
            <p style="font-size:12px; color:#8a6d1a; margin:0 0 6px;">(retard &lt; 30j)</p>
            <p style="font-size:22px; font-weight:700; margin:0; color:#8a6d1a;">@Model.PortfolioOrange</p>
        </div>
        <div style="background:#FDEAEA; border-radius:10px; padding:14px;">
            <p style="font-size:12px; color:#a12020; margin:0 0 6px;">(retard &gt; 30j)</p>
            <p style="font-size:22px; font-weight:700; margin:0; color:#a12020;">@Model.PortfolioRouge</p>
        </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
        <div style="background:#fff; border:1px solid #E1E0DB; border-radius:12px; padding:16px;">
            <p style="font-size:13px; font-weight:600; margin:0 0 10px;">Répartition In House / Outsourced</p>
            <div style="height:220px;">
                <canvas id="chartType"></canvas>
            </div>
        </div>
        <div style="background:#fff; border:1px solid #E1E0DB; border-radius:12px; padding:16px;">
            <p style="font-size:13px; font-weight:600; margin:0 0 10px;">Répartition par plateforme</p>
            <div style="height:220px;">
                <canvas id="chartPlateforme"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
    new Chart(document.getElementById('chartType'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.RepartitionParType.Select(t => t.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.RepartitionParType.Select(t => t.Valeur))), backgroundColor: ['#228B22', '#5F5E5A'] }]
        },
        options: { maintainAspectRatio: false }
    });

    new Chart(document.getElementById('chartPlateforme'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.RepartitionParPlateforme.Select(p => p.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.RepartitionParPlateforme.Select(p => p.Valeur))), backgroundColor: '#228B22' }]
        },
        options: { maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });
</script>