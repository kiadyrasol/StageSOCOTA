@model List<GestionProjetSocota.Models.Notification>

<h1 class="h3 mb-3">
    <i class="fas fa-bell"></i>
    Notifications
</h1>

<div class="card">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-4">
                <i class="fas fa-bell-slash fa-2x mb-3"></i>

                <p class="mb-0">
                    Aucune notification envoyée.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Projet</th>
                            <th>Type</th>
                            <th>Destinataire</th>
                            <th>Date d'envoi</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var notification in Model)
                        {
                            <tr>

                                <td>
                                    @if (notification.Projet != null)
                                    {
                                        <a href="/Projet/Details/@notification.ProjetId">
                                            @notification.Projet.Nom
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Projet supprimé
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        @notification.Type
                                    </span>
                                </td>

                                <td>
                                    @notification.Destinataire
                                </td>

                                <td>
                                    @notification.DateEnvoi.ToString("dd/MM/yyyy HH:mm")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>