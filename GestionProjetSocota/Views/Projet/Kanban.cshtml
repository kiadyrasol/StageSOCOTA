@model List<GestionProjetSocota.Models.Projet>
@{
    var statuts = ViewBag.StatutsAffiches as List<GestionProjetSocota.Models.StatutProjet>;
}

<h1 class="h3 mb-3">Kanban</h1>

<div class="d-flex gap-3" style="overflow-x:auto;">
    @foreach (var statut in statuts!)
    {
        var projetsDuStatut = Model.Where(p => p.Statut == statut).ToList();

        <div class="card" style="min-width:250px; flex-shrink:0;">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span class="small fw-bold">@statut</span>
                <span class="badge bg-secondary">@projetsDuStatut.Count</span>
            </div>
            <div class="card-body p-2">
                @foreach (var projet in projetsDuStatut)
                {
                    <a href="/Projet/Details/@projet.Id" class="card mb-2 text-decoration-none text-dark">
                        <div class="card-body p-2">
                            <div class="fw-bold small">@projet.Nom</div>
                            <div class="text-muted small">@projet.TicketId</div>
                            <div class="text-muted small">@(projet.OwnerIt?.Nom ?? "-")</div>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</div>