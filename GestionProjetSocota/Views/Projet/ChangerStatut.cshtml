@model GestionProjetSocota.Models.Projet

<h1 class="h3 mb-3">Changer le statut</h1>

<div class="card">
    <div class="card-body">
        <div class="border rounded p-3 mb-3 bg-light">
            <p class="mb-1"><b>Projet :</b> @Model.Nom</p>
            <p class="mb-1"><b>Type :</b> @Model.Type</p>
            <p class="mb-0"><b>Statut actuel :</b> <span class="badge bg-success">@Model.Statut</span></p>
        </div>

        @if (TempData["Erreur"] != null)
        {
            <div class="alert alert-danger">@TempData["Erreur"]</div>
        }

        @if (Model.Statut == GestionProjetSocota.Models.StatutProjet.Suspendu || Model.Statut == GestionProjetSocota.Models.StatutProjet.Cancelled)
        {
            <div class="alert alert-warning">
                Ce projet est actuellement <b>@Model.Statut</b>. Vous pouvez le réactiver : il reprendra son statut précédent (<b>@Model.StatutPrecedent</b>).
            </div>

            <form asp-action="ChangerStatut" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="nouveauStatut" value="@Model.StatutPrecedent" />
                <button type="submit" class="btn btn-socota"><i class="fas fa-redo"></i> Réactiver le projet</button>
            </form>
        }
        else
        {
            <form asp-action="ChangerStatut" method="post">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label">Nouveau statut</label>
                    <select name="nouveauStatut" class="form-select">
                        @{
                            var transitions = ViewBag.TransitionsPossibles as List<GestionProjetSocota.Models.StatutProjet>;
                        }
                        @if (transitions != null && transitions.Any())
                        {
                            @foreach (var statut in transitions)
                            {
                                <option value="@statut">@statut</option>
                            }
                        }
                        else
                        {
                            <option disabled>Aucune transition possible</option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-socota">Valider le changement</button>
            </form>
        }
    </div>
</div>