@model GestionProjetSocota.ViewModels.ProjetCreateViewModel

<div style="padding:20px; max-width:600px;">
    <h2 style="color:#155D15; margin-bottom:18px;">Créer un projet</h2>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" style="color:red; font-size:13px; margin-bottom:12px;"></div>

        <label>Ticket ID</label>
        <input asp-for="TicketId" type="text" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px; margin-bottom:6px;" />
        <span asp-validation-for="TicketId" style="color:red; font-size:12px;"></span>

        <label style="display:block; margin-top:10px;">Référence</label>
        <input asp-for="Reference" type="text" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;" />

        <label style="display:block; margin-top:10px;">Nom du projet</label>
        <input asp-for="Nom" type="text" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px; margin-bottom:6px;" />
        <span asp-validation-for="Nom" style="color:red; font-size:12px;"></span>

        <label style="display:block; margin-top:10px;">Description</label>
        <textarea asp-for="Description" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px; min-height:70px;"></textarea>

        <label style="display:block; margin-top:10px;">Unité</label>
        <select asp-for="Unite" asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.Unite>()" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;"></select>

        <label style="display:block; margin-top:10px;">Département</label>
        <select asp-for="Departement" asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.Departement>()" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;"></select>

        <label style="display:block; margin-top:10px;">Type</label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.TypeProjet>()" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;"></select>

        <label style="display:block; margin-top:10px;">Plateforme</label>
        <select asp-for="Plateforme" asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.Plateforme>()" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;"></select>

        <label style="display:block; margin-top:10px;">Owner IT</label>
        <select asp-for="OwnerItId" asp-items="@(new SelectList(Model.UtilisateursDisponibles, "Id", "Nom"))" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;">
            <option value="">Aucun</option>
        </select>

        <label style="display:block; margin-top:10px;">Power User</label>
        <select asp-for="PowerUserId" asp-items="@(new SelectList(Model.UtilisateursDisponibles, "Id", "Nom"))" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;">
            <option value="">Aucun</option>
        </select>

        <label style="display:block; margin-top:10px;">Deadline</label>
        <input asp-for="Deadline" type="date" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;" />

        <button type="submit" style="margin-top:18px; width:100%; padding:10px; border:none; border-radius:8px; background:#228B22; color:#fff; font-weight:600; font-size:13px; cursor:pointer;">Créer le projet</button>
    </form>
</div>