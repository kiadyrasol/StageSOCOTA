@model GestionProjetSocota.ViewModels.ProjetCreateViewModel

<style>
    .create-page {
        --socota-green: #8BC53F;
        --socota-green-dark: #70A130;
    }

    .create-title {
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .create-subtitle {
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
    }

    .create-card {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .create-section {
        padding-bottom: 1.25rem;
        margin-bottom: 1.25rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .create-section:last-of-type {
        border-bottom: 0;
        margin-bottom: 0;
    }

    .create-section-title {
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .create-section-title i {
        color: var(--socota-green);
        margin-right: 0.4rem;
    }

    .form-label {
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 0.4rem;
    }

    .form-control,
    .form-select {
        border-radius: 6px;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--socota-green);
        box-shadow: 0 0 0 0.2rem rgba(139, 197, 63, 0.15);
    }

    .create-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        padding-top: 1rem;
    }

    .btn-socota {
        background-color: var(--socota-green);
        border-color: var(--socota-green);
        color: #ffffff;
    }

    .btn-socota:hover {
        background-color: var(--socota-green-dark);
        border-color: var(--socota-green-dark);
        color: #ffffff;
    }

    body[data-bs-theme="dark"] .create-card {
        border-color: #3a3f44;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    body[data-bs-theme="dark"] .create-section {
        border-color: #3a3f44;
    }

    body[data-bs-theme="dark"] .create-subtitle {
        color: #a0a0a0;
    }
</style>


<div class="create-page">

    <div class="mb-4">

        <h1 class="h3 create-title">
            Créer un projet
        </h1>

        <p class="create-subtitle mb-0">
            Renseignez les informations nécessaires à la création du projet.
        </p>

    </div>


    <div class="card create-card">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <!-- INFORMATIONS GÉNÉRALES -->

                <div class="create-section">

                    <div class="create-section-title">
                        <i class="fas fa-folder-open"></i>
                        Informations générales
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Ticket ID
                            </label>

                            <input asp-for="TicketId"
                                   type="text"
                                   class="form-control"
                                   placeholder="Ex. TCK-001" />

                            <span asp-validation-for="TicketId"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Référence
                            </label>

                            <input asp-for="Reference"
                                   type="text"
                                   class="form-control"
                                   placeholder="Référence du projet" />

                        </div>


                        <div class="col-12 mb-3">

                            <label class="form-label">
                                Nom du projet
                            </label>

                            <input asp-for="Nom"
                                   type="text"
                                   class="form-control"
                                   placeholder="Nom du projet" />

                            <span asp-validation-for="Nom"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="col-12">

                            <label class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Décrivez brièvement le projet...">
                            </textarea>

                        </div>

                    </div>

                </div>


                <!-- CLASSIFICATION -->

                <div class="create-section">

                    <div class="create-section-title">
                        <i class="fas fa-tags"></i>
                        Classification
                    </div>

                    <div class="row">

                        <div class="col-md-4 mb-3">

                            <label class="form-label">
                                Unité
                            </label>

                            <select asp-for="Unite"
                                    asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.Unite>()"
                                    class="form-select">
                            </select>

                        </div>


                        <div class="col-md-4 mb-3">

                            <label class="form-label">
                                Département
                            </label>

                            <select asp-for="Departement"
                                    asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.Departement>()"
                                    class="form-select">
                            </select>

                        </div>


                        <div class="col-md-4 mb-3">

                            <label class="form-label">
                                Type
                            </label>

                            <select asp-for="Type"
                                    asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.TypeProjet>()"
                                    class="form-select">
                            </select>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Plateforme
                            </label>

                            <select asp-for="Plateforme"
                                    asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.Plateforme>()"
                                    class="form-select">
                            </select>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Priorité
                            </label>

                            <select asp-for="Priorite"
                                    asp-items="Html.GetEnumSelectList<GestionProjetSocota.Models.PrioriteProjet>()"
                                    class="form-select">
                            </select>

                        </div>

                    </div>

                </div>


                <!-- RESPONSABLES ET ÉCHÉANCE -->

                <div class="create-section">

                    <div class="create-section-title">
                        <i class="fas fa-users"></i>
                        Responsables et échéance
                    </div>

                    <div class="row">

                        <div class="col-md-4 mb-3">

                            <label class="form-label">
                                Owner IT
                            </label>

                            <select asp-for="OwnerItId"
                                    asp-items="@(new SelectList(Model.UtilisateursDisponibles, "Id", "Nom"))"
                                    class="form-select">

                                <option value="">
                                    Aucun
                                </option>

                            </select>

                        </div>


                        <div class="col-md-4 mb-3">

                            <label class="form-label">
                                Power User
                            </label>

                            <select asp-for="PowerUserId"
                                    asp-items="@(new SelectList(Model.UtilisateursDisponibles, "Id", "Nom"))"
                                    class="form-select">

                                <option value="">
                                    Aucun
                                </option>

                            </select>

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                Deadline
                            </label>

                            <input asp-for="Deadline"
                                   type="date"
                                   class="form-control" />

                        </div>

                    </div>

                </div>


                <!-- ACTIONS -->

                <div class="create-actions">

                    <a href="/Projet"
                       class="btn btn-outline-secondary">

                        <i class="fas fa-times"></i>
                        Annuler

                    </a>

                    <button type="submit"
                            class="btn btn-socota">

                        <i class="fas fa-plus"></i>
                        Créer le projet

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>