@model List<GestionProjetSocota.Models.Projet>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Projets</h1>
    <a href="/Projet/Create" class="btn btn-socota"><i class="fas fa-plus"></i> Nouveau projet</a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted p-3 mb-0">Aucun projet pour le moment.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Référence</th>
                            <th>Ticket ID</th>
                            <th>Nom</th>
                            <th>Unité</th>
                            <th>Statut</th>
                            <th>Owner IT</th>
                            <th>Power User</th>
                            <th>Type</th>
                            <th>Plateforme</th>
                            <th>Deadline</th>
                            <th>Avancement</th>
                            <th>Risque</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var projet in Model)
                        {
                            <tr>
                                <td>@(string.IsNullOrEmpty(projet.Reference) ? "-" : projet.Reference)</td>
                                <td>@projet.TicketId</td>
                                <td>@projet.Nom</td>
                                <td>@projet.Unite</td>
                                <td><span class="badge bg-success">@projet.Statut</span></td>
                                <td>@(projet.OwnerIt?.Nom ?? "-")</td>
                                <td>@(projet.PowerUser?.Nom ?? "-")</td>
                                <td>@projet.Type</td>
                                <td>@projet.Plateforme</td>
                                <td>
                                    @if (projet.Deadline.HasValue)
                                    {
                                        <span class="@(projet.Deadline.Value < DateTime.Now ? "text-danger fw-bold" : "")">
                                            @projet.Deadline.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td style="min-width: 120px;">
                                    <div class="progress" style="height:18px;">
                                        <div class="progress-bar bg-success" role="progressbar"
                                             style="width:@(projet.PourcentageAvancement)%">
                                            @projet.PourcentageAvancement%
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var scores = ViewBag.Scores as Dictionary<int, (int score, string couleur)>;
                                        var (score, couleur) = scores != null && scores.ContainsKey(projet.Id) ? scores[projet.Id] :
                                                (0, "secondary");
                                    }
                                    <span class="badge bg-@couleur">@score</span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <a href="/Projet/Details/@projet.Id" class="btn btn-sm btn-outline-secondary"
                                       title="Voir"><i class="fas fa-eye"></i></a>
                                    <a href="/Projet/ChangerStatut/@projet.Id" class="btn btn-sm btn-outline-success"
                                       title="Changer Statut"><i class="fas fa-exchange-alt"></i></a>
                                    <a href="/Projet/Edit/@projet.Id" class="btn btn-sm btn-outline-primary" title="Éditer"><i
                                        class="fas fa-edit"></i></a>
                                        <a href="/Projet/Delete/@projet.Id" class="btn btn-sm btn-outline-danger"
                                           title="Supprimer"><i class="fas fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>