@model List<GestionProjetSocota.Models.Projet>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Projets</h1>
    <a href="/Projet/Create" class="btn btn-socota"><i class="fas fa-plus"></i> Nouveau projet</a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted p-3 mb-0">Aucun projet pour le moment.</p>
        }
        else
        {
            <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ticket ID</th>
                        <th>Nom</th>
                        <th>Unité</th>
                        <th>Statut</th>
                        <th>Owner IT</th>
                        <th>Avancement</th>
                        <th>Actions</th>
                        <th>Risque</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var projet in Model)
                    {
                        <tr>
                            <td>@projet.TicketId</td>
                            <td>@projet.Nom</td>
                            <td>@projet.Unite</td>
                            <td><span class="badge bg-success">@projet.Statut</span></td>
                            <td>@(projet.OwnerIt?.Nom ?? "-")</td>
                            <td>
                                <div class="progress" style="height:18px;">
                                    <div class="progress-bar bg-success" style="width:@(projet.PourcentageAvancement)%">@projet.PourcentageAvancement%</div>
                                </div>
                            </td>
                            <td>
                                <a href="/Projet/Details/@projet.Id" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye"></i></a>
                                <a href="/Projet/ChangerStatut/@projet.Id" class="btn btn-sm btn-outline-success"><i class="fas fa-exchange-alt"></i></a>
                                <a href="/Projet/Edit/@projet.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                                <a href="/Projet/Delete/@projet.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a>
                            </td>
                            <td>
                                @{
                                var scores = ViewBag.Scores as Dictionary<int, (int score, string couleur)>;
                                var (score, couleur) = scores != null && scores.ContainsKey(projet.Id) ? scores[projet.Id] : (0, "secondary");
                                }
                                <span class="badge bg-@couleur">@score</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
</div>