@model GestionProjetSocota.Models.Projet

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1 text-danger">Confirmer la suppression</h1>
        <p class="text-muted mb-0">
            Cette action est définitive et ne pourra pas être annulée.
        </p>
    </div>

    <a href="/Projet" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>
        Retour
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <div class="alert alert-danger d-flex align-items-start mb-4" role="alert">
            <i class="fas fa-triangle-exclamation mt-1 me-3"></i>

            <div>
                <div class="fw-semibold mb-1">
                    Attention
                </div>

                <div>
                    Êtes-vous sûr de vouloir supprimer ce projet ?
                    Toutes les informations associées seront définitivement supprimées.
                </div>
            </div>
        </div>

        <div class="bg-light rounded p-3 mb-4">
            <div class="row g-3">

                <div class="col-md-6">
                    <span class="text-muted small d-block">Nom du projet</span>
                    <span class="fw-semibold">@Model.Nom</span>
                </div>

                <div class="col-md-3">
                    <span class="text-muted small d-block">Ticket ID</span>
                    <span class="fw-semibold">@Model.TicketId</span>
                </div>

                <div class="col-md-3">
                    <span class="text-muted small d-block">Unité</span>
                    <span class="fw-semibold">@Model.Unite</span>
                </div>

                <div class="col-12">
                    <span class="text-muted small d-block">Owner IT</span>
                    <span class="fw-semibold">
                        @(Model.OwnerIt?.Nom ?? "-")
                    </span>
                </div>

            </div>
        </div>

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-2">

                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash me-1"></i>
                    Oui, supprimer
                </button>

                <a href="/Projet" class="btn btn-outline-secondary">
                    Annuler
                </a>

            </div>

        </form>

    </div>
</div>