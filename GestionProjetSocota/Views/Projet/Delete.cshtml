@model GestionProjetSocota.Models.Projet

<h1 class="h3 mb-3 text-danger">Confirmer la suppression</h1>

<div class="card">
    <div class="card-body">
        <p>Es-tu sûr de vouloir supprimer ce projet ? Cette action est irréversible.</p>

        <div class="border rounded p-3 mb-3 bg-light">
            <p class="mb-1"><b>Ticket ID :</b> @Model.TicketId</p>
            <p class="mb-1"><b>Nom :</b> @Model.Nom</p>
            <p class="mb-1"><b>Unité :</b> @Model.Unite</p>
            <p class="mb-0"><b>Owner IT :</b> @(Model.OwnerIt?.Nom ?? "-")</p>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Oui, supprimer</button>
            <a href="/Projet" class="btn btn-outline-secondary">Annuler</a>
        </form>
    </div>
</div>