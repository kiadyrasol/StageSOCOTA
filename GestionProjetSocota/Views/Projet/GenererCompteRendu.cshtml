@{
    var projet = ViewBag.Projet as GestionProjetSocota.Models.Projet;
    var compteRendu = ViewBag.CompteRendu as string;
}

<h1 class="h3 mb-3">Compte-rendu généré par IA</h1>
<p class="text-muted small mb-3">Projet : <b>@projet?.Nom</b></p>

<div class="card mb-3">
    <div class="card-body" style="white-space:pre-wrap; line-height:1.6;">
        @compteRendu
    </div>
</div>

<a href="/Projet/GenererCompteRendu/@projet?.Id" class="btn btn-socota"><i class="fas fa-sync"></i> Régénérer</a>
<a href="/Projet/Details/@projet?.Id" class="btn btn-outline-secondary">← Retour au projet</a>