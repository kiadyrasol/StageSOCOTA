@model GestionProjetSocota.ViewModels.DashboardViewModel

<style>
    :root {
        --socota-green: #8BC53F;
        --socota-green-dark: #70A130;
        --dashboard-border: #e4e7eb;
        --dashboard-muted: #6c757d;
        --dashboard-card: #ffffff;
        --dashboard-header-h: 56px; /* ajuste selon la hauteur réelle de ta topbar */
    }

    html, body {
        overflow: hidden;
        height: 100%;
    }

    .dashboard-page {
        height: calc(100vh - var(--dashboard-header-h));
        max-height: calc(100vh - var(--dashboard-header-h));
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .dashboard-title {
        font-weight: 700;
        margin-bottom: 2px;
        color: var(--socota-green-dark);
        font-size: 1.3rem;
    }

    .dashboard-subtitle {
        color: var(--dashboard-muted);
        font-size: 0.82rem;
        margin-bottom: 10px;
    }

    .dashboard-kpi {
        height: 100%;
        border: 1px solid var(--dashboard-border);
        border-radius: 0.8rem;
        background-color: var(--dashboard-card);
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .dashboard-kpi:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(139, 197, 63, 0.16);
    }

    .dashboard-kpi-body {
        padding: 10px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dashboard-kpi-icon {
        flex-shrink: 0;
        width: 34px;
        height: 34px;
        border-radius: 0.65rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        background: linear-gradient(135deg, #eef8de, #d7edb2);
        color: var(--socota-green-dark);
    }

    .kpi-danger .dashboard-kpi-icon {
        background: linear-gradient(135deg, #fbe6e3, #f7cfc9);
        color: #dc3545;
    }

    .dashboard-kpi-label {
        color: var(--dashboard-muted);
        font-size: 0.7rem;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .dashboard-kpi-value {
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1;
        margin: 0;
    }

    .kpi-active {
        border-left: 4px solid var(--socota-green);
    }

    .kpi-active .dashboard-kpi-value {
        color: var(--socota-green-dark);
    }

    .kpi-danger {
        border-left: 4px solid #dc3545;
    }

    .dashboard-chart-card {
        height: 100%;
        border: 1px solid var(--dashboard-border);
        border-radius: 0.8rem;
        background-color: var(--dashboard-card);
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
        display: flex;
        flex-direction: column;
    }

    .dashboard-chart-header {
        padding: 10px 14px 0;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    .dashboard-chart-header i {
        color: var(--socota-green-dark);
        font-size: 0.75rem;
    }

    .dashboard-chart-title {
        font-size: 0.8rem;
        font-weight: 700;
        margin: 0;
    }

    .dashboard-chart-body {
        padding: 6px 12px 10px;
        flex: 1 1 auto;
        min-height: 0;
    }

    .dashboard-chart {
        position: relative;
        height: 100%;
        min-height: 0;
    }

    .dashboard-kpis-row {
        flex-shrink: 0;
    }

    .dashboard-charts-row {
        flex: 1 1 auto;
        min-height: 0;
    }

    .dashboard-charts-row > .row {
        height: 100%;
    }

    body[data-bs-theme="dark"] {
        --dashboard-border: #3b4147;
        --dashboard-muted: #a8adb3;
        --dashboard-card: #2b2f33;
    }

    body[data-bs-theme="dark"] .dashboard-kpi,
    body[data-bs-theme="dark"] .dashboard-chart-card {
        box-shadow: none;
    }

    @@media (max-width: 900px) {
        html, body { overflow: auto; }
        .dashboard-page {
            height: auto;
            max-height: none;
            overflow: visible;
        }
    }
</style>


<div class="dashboard-page">

    <div class="mb-2">

        <h1 class="dashboard-title">
            Dashboard Exécutif
        </h1>

        <p class="dashboard-subtitle mb-0">
            Vue synthétique du portefeuille projets
        </p>

    </div>

    <div class="row g-2 mb-2 dashboard-kpis-row">

        <div class="col-xl col-md-6">
            <div class="dashboard-kpi">

                <div class="dashboard-kpi-body">

                    <span class="dashboard-kpi-icon">
                        <i class="fas fa-layer-group"></i>
                    </span>

                    <div>
                        <div class="dashboard-kpi-label">
                            Total projets
                        </div>

                        <p class="dashboard-kpi-value">
                            @Model.TotalProjets
                        </p>
                    </div>

                </div>

            </div>
        </div>


        <div class="col-xl col-md-6">
            <div class="dashboard-kpi kpi-active">

                <div class="dashboard-kpi-body">

                    <span class="dashboard-kpi-icon">
                        <i class="fas fa-bolt"></i>
                    </span>

                    <div>
                        <div class="dashboard-kpi-label">
                            Projets actifs
                        </div>

                        <p class="dashboard-kpi-value">
                            @Model.ProjetsActifs
                        </p>
                    </div>

                </div>

            </div>
        </div>


        <div class="col-xl col-md-6">
            <div class="dashboard-kpi">

                <div class="dashboard-kpi-body">

                    <span class="dashboard-kpi-icon">
                        <i class="fas fa-circle-check"></i>
                    </span>

                    <div>
                        <div class="dashboard-kpi-label">
                            Projets terminés
                        </div>

                        <p class="dashboard-kpi-value">
                            @Model.ProjetsTermines
                        </p>
                    </div>

                </div>

            </div>
        </div>


        <div class="col-xl col-md-6">
            <div class="dashboard-kpi">

                <div class="dashboard-kpi-body">

                    <span class="dashboard-kpi-icon">
                        <i class="fas fa-pause"></i>
                    </span>

                    <div>
                        <div class="dashboard-kpi-label">
                            Bloqués / suspendus
                        </div>

                        <p class="dashboard-kpi-value">
                            @Model.ProjetsSuspendus
                        </p>
                    </div>

                </div>

            </div>
        </div>


        <div class="col-xl col-md-6">
            <div class="dashboard-kpi kpi-danger">

                <div class="dashboard-kpi-body">

                    <span class="dashboard-kpi-icon">
                        <i class="fas fa-triangle-exclamation"></i>
                    </span>

                    <div>
                        <div class="dashboard-kpi-label text-danger">
                            Projets en retard
                        </div>

                        <p class="dashboard-kpi-value text-danger">
                            @Model.ProjetsEnRetard
                        </p>
                    </div>

                </div>

            </div>
        </div>

    </div>

    <div class="dashboard-charts-row">

        <div class="row g-2 h-100">

            <div class="col-lg-3 col-md-6">

                <div class="dashboard-chart-card">

                    <div class="dashboard-chart-header">
                        <i class="fas fa-chart-column"></i>
                        <p class="dashboard-chart-title">
                            Par statut
                        </p>
                    </div>

                    <div class="dashboard-chart-body">

                        <div class="dashboard-chart">
                            <canvas id="chartStatut"></canvas>
                        </div>

                    </div>

                </div>

            </div>


            <div class="col-lg-3 col-md-6">

                <div class="dashboard-chart-card">

                    <div class="dashboard-chart-header">
                        <i class="fas fa-chart-pie"></i>
                        <p class="dashboard-chart-title">
                            Par entité
                        </p>
                    </div>

                    <div class="dashboard-chart-body">

                        <div class="dashboard-chart">
                            <canvas id="chartUnite"></canvas>
                        </div>

                    </div>

                </div>

            </div>


            <div class="col-lg-3 col-md-6">

                <div class="dashboard-chart-card">

                    <div class="dashboard-chart-header">
                        <i class="fas fa-chart-column"></i>
                        <p class="dashboard-chart-title">
                            Par département
                        </p>
                    </div>

                    <div class="dashboard-chart-body">

                        <div class="dashboard-chart">
                            <canvas id="chartDepartement"></canvas>
                        </div>

                    </div>

                </div>

            </div>


            <div class="col-lg-3 col-md-6">

                <div class="dashboard-chart-card">

                    <div class="dashboard-chart-header">
                        <i class="fas fa-users-gear"></i>
                        <p class="dashboard-chart-title">
                            Charge responsables IT
                        </p>
                    </div>

                    <div class="dashboard-chart-body">

                        <div class="dashboard-chart">
                            <canvas id="chartResponsable"></canvas>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>

<script>
    const socotaGreen = '#8BC53F';
    const chartSecondary = '#5F5E5A';
    const chartLight = '#E1E0DB';

    const chartTextColor =
        document.body.getAttribute('data-bs-theme') === 'dark'
            ? '#e0e0e0'
            : '#495057';

    const chartGridColor =
        document.body.getAttribute('data-bs-theme') === 'dark'
            ? '#3b4147'
            : '#e9ecef';


    const chartOptions = {
        responsive: true,
        maintainAspectRatio: false,

        plugins: {
            legend: {
                display: false
            }
        },

        scales: {
            x: {
                ticks: {
                    color: chartTextColor
                },
                grid: {
                    display: false
                }
            },

            y: {
                beginAtZero: true,
                ticks: {
                    color: chartTextColor,
                    precision: 0
                },
                grid: {
                    color: chartGridColor
                }
            }
        }
    };

    new Chart(document.getElementById('chartStatut'), {

        type: 'bar',

        data: {
            labels: @Html.Raw(Json.Serialize(
                Model.RepartitionParStatut.Select(s => s.Label)
            )),

            datasets: [{
                data: @Html.Raw(Json.Serialize(
                    Model.RepartitionParStatut.Select(s => s.Valeur)
                )),

                backgroundColor: socotaGreen,
                borderRadius: 5,
                borderSkipped: false
            }]
        },

        options: chartOptions
    });

    new Chart(document.getElementById('chartUnite'), {

        type: 'doughnut',

        data: {
            labels: @Html.Raw(Json.Serialize(
                Model.RepartitionParUnite.Select(u => u.Label)
            )),

            datasets: [{
                data: @Html.Raw(Json.Serialize(
                    Model.RepartitionParUnite.Select(u => u.Valeur)
                )),

                backgroundColor: [
                    socotaGreen,
                    chartSecondary,
                    chartLight
                ],

                borderWidth: 2,
                borderColor:
                    document.body.getAttribute('data-bs-theme') === 'dark'
                        ? '#2b2f33'
                        : '#ffffff'
            }]
        },

        options: {
            responsive: true,
            maintainAspectRatio: false,

            cutout: '65%',

            plugins: {
                legend: {
                    position: 'bottom',

                    labels: {
                        color: chartTextColor,
                        padding: 8,
                        boxWidth: 10,
                        font: { size: 10 },
                        usePointStyle: true
                    }
                }
            }
        }
    });

    new Chart(document.getElementById('chartDepartement'), {

        type: 'bar',

        data: {
            labels: @Html.Raw(Json.Serialize(
                Model.RepartitionParDepartement.Select(d => d.Label)
            )),

            datasets: [{
                data: @Html.Raw(Json.Serialize(
                    Model.RepartitionParDepartement.Select(d => d.Valeur)
                )),

                backgroundColor: socotaGreen,
                borderRadius: 5,
                borderSkipped: false
            }]
        },

        options: chartOptions
    });

    new Chart(document.getElementById('chartResponsable'), {

        type: 'bar',

        data: {
            labels: @Html.Raw(Json.Serialize(
                Model.ChargeParOwnerIt.Select(c => c.Label)
            )),

            datasets: [{
                data: @Html.Raw(Json.Serialize(
                    Model.ChargeParOwnerIt.Select(c => c.Valeur)
                )),

                backgroundColor: socotaGreen,
                borderRadius: 5,
                borderSkipped: false
            }]
        },

        options: {
            ...chartOptions,

            indexAxis: 'y',

            scales: {
                x: {
                    beginAtZero: true,

                    ticks: {
                        color: chartTextColor,
                        precision: 0
                    },

                    grid: {
                        color: chartGridColor
                    }
                },

                y: {
                    ticks: {
                        color: chartTextColor
                    },

                    grid: {
                        display: false
                    }
                }
            }
        }
    });
</script>