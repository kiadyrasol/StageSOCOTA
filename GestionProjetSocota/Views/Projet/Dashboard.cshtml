@model GestionProjetSocota.ViewModels.DashboardViewModel

<h1 class="h3 mb-3">Dashboard Exécutif</h1>

<div class="row mb-4">
    <div class="col">
        <div class="card"><div class="card-body">
            <p class="text-muted small mb-1">Total projets</p>
            <p class="h4 mb-0">@Model.TotalProjets</p>
        </div></div>
    </div>
    <div class="col">
        <div class="card bg-light-success"><div class="card-body">
            <p class="text-success small mb-1">Actifs</p>
            <p class="h4 mb-0 text-success">@Model.ProjetsActifs</p>
        </div></div>
    </div>
    <div class="col">
        <div class="card"><div class="card-body">
            <p class="text-muted small mb-1">Terminés</p>
            <p class="h4 mb-0">@Model.ProjetsTermines</p>
        </div></div>
    </div>
    <div class="col">
        <div class="card"><div class="card-body">
            <p class="text-muted small mb-1">Bloqués (Suspendus)</p>
            <p class="h4 mb-0">@Model.ProjetsSuspendus</p>
        </div></div>
    </div>
    <div class="col">
        <div class="card border-danger"><div class="card-body">
            <p class="text-danger small mb-1">En retard</p>
            <p class="h4 mb-0 text-danger">@Model.ProjetsEnRetard</p>
        </div></div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <p class="fw-bold small">Répartition par statut</p>
            <div style="height:220px;"><canvas id="chartStatut"></canvas></div>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <p class="fw-bold small">Répartition par entité (unité)</p>
            <div style="height:220px;"><canvas id="chartUnite"></canvas></div>
        </div></div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <p class="fw-bold small">Répartition par département</p>
            <div style="height:220px;"><canvas id="chartDepartement"></canvas></div>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <p class="fw-bold small">Répartition par responsable IT</p>
            <div style="height:220px;"><canvas id="chartResponsable"></canvas></div>
        </div></div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
    new Chart(document.getElementById('chartStatut'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.RepartitionParStatut.Select(s => s.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.RepartitionParStatut.Select(s => s.Valeur))), backgroundColor: '#228B22' }]
        },
        options: { maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });

    new Chart(document.getElementById('chartUnite'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.RepartitionParUnite.Select(u => u.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.RepartitionParUnite.Select(u => u.Valeur))), backgroundColor: ['#228B22', '#5F5E5A', '#E1E0DB'] }]
        },
        options: { maintainAspectRatio: false }
    });

    new Chart(document.getElementById('chartDepartement'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.RepartitionParDepartement.Select(d => d.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.RepartitionParDepartement.Select(d => d.Valeur))), backgroundColor: '#155D15' }]
        },
        options: { maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });

    new Chart(document.getElementById('chartResponsable'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.ChargeParOwnerIt.Select(c => c.Label))),
            datasets: [{ data: @Html.Raw(Json.Serialize(Model.ChargeParOwnerIt.Select(c => c.Valeur))), backgroundColor: '#228B22' }]
        },
        options: { maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });
</script>