@model List<GestionProjetSocota.Models.Projet>

<h1 class="h3 mb-3">Gantt</h1>

<div class="card">
    <div class="card-body">

        @if (!Model.Any(p => p.DateDebut.HasValue && p.DateFin.HasValue))
        {
            <p class="text-muted mb-0">
                Aucun projet avec une date de début et une date de fin définies
                pour afficher le Gantt.
            </p>
        }
        else
        {
            <div class="gantt-wrapper">
                <svg id="gantt"></svg>
            </div>
        }

    </div>
</div>

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/frappe-gantt@0.6.1/dist/frappe-gantt.css">

<style>
    .gantt-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .gantt .bar {
        fill: var(--socota-green);
    }

    .gantt .bar-progress {
        fill: #70A130;
    }

    .gantt .bar-label {
        fill: #ffffff;
    }

    .gantt .bar-wrapper:hover .bar {
        fill: #70A130;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/frappe-gantt@0.6.1/dist/frappe-gantt.min.js"></script>

<script>
    const taches = @Html.Raw(
        Json.Serialize(
            Model
                .Where(p => p.DateDebut.HasValue && p.DateFin.HasValue)
                .Select(p => new
                {
                    id = p.Id.ToString(),
                    name = p.Nom,

                    start = p.DateDebut!.Value
                        .ToString("yyyy-MM-dd"),

                    end = p.DateFin!.Value
                        .ToString("yyyy-MM-dd"),

                    progress = p.PourcentageAvancement
                })
        )
    );

    if (taches.length > 0) {

        new Gantt("#gantt", taches, {

            view_mode: "Month",

            on_click: function (tache) {
                window.location.href =
                    "/Projet/Details/" + tache.id;
            }
        });

    }
</script>