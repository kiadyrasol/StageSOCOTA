        <!-- =====================================================
             MESSAGES 
             ===================================================== -->

        @if (afficherFlash && (!string.IsNullOrWhiteSpace(messageSucces) || !string.IsNullOrWhiteSpace(messageErreur)))
        {
            <div class="flash-stack" aria-live="polite">

                @if (!string.IsNullOrWhiteSpace(messageSucces))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" data-autohide="6000">
