@{
    // ============================================================
    // TITRE
    // ============================================================
    var titrePage = ViewData["Title"] as string;
    var titreComplet = string.IsNullOrWhiteSpace(titrePage)
        ? "GestionProjetSocota"
        : $"{titrePage} - GestionProjetSocota";

    // ============================================================
    // ROUTE COURANTE 
    // ============================================================
    var chemin = (Context.Request.Path.Value ?? "/").TrimEnd('/');
    if (chemin.Length == 0) { chemin = "/"; }

    bool EstPage(params string[] routes) =>
        routes.Any(r => chemin.Equals(r, StringComparison.OrdinalIgnoreCase));

    bool CommencePar(params string[] prefixes) =>
        prefixes.Any(p => chemin.StartsWith(p, StringComparison.OrdinalIgnoreCase));

    string Actif(bool actif) => actif ? "active" : string.Empty;

    var projetsActif =
        EstPage("/Projet", "/Projet/Index") ||
        CommencePar("/Projet/Details", "/Projet/Edit", "/Projet/ChangerStatut",
                    "/Projet/Delete", "/Projet/GenererCompteRendu");

    var kanbanActif = EstPage("/Projet/Kanban");
    var roadmapActif = EstPage("/Projet/Roadmap");
    var ganttActif = EstPage("/Projet/Gantt");
    var dashExecActif = EstPage("/Projet/Dashboard");
    var dashComexActif = EstPage("/Projet/DashboardComex");
    var dashItActif = EstPage("/Projet/DashboardItManager");
    var createActif = EstPage("/Projet/Create");
    var importActif = EstPage("/Projet/ImporterExcel");
    var utilisateursActif = CommencePar("/Utilisateur");

    // ============================================================
    // DROITS
    // ============================================================
    var estAdmin = User.IsInRole("Administrateur");
    var peutGerer = estAdmin || User.IsInRole("ChefDeProjet");

    // ============================================================
    // UTILISATEUR 
    // ============================================================
    var nomUtilisateur = User.Identity?.Name ?? string.Empty;
    var nomCourt = nomUtilisateur.Contains('\\')
        ? nomUtilisateur.Substring(nomUtilisateur.LastIndexOf('\\') + 1)
        : nomUtilisateur;
    var initiale = string.IsNullOrWhiteSpace(nomCourt)
        ? "?"
        : char.ToUpperInvariant(nomCourt.Trim()[0]).ToString();

    // ============================================================
    // MESSAGES 
    // ============================================================
    var messageSucces = TempData["Succes"]?.ToString();
    var messageErreur = TempData["Erreur"]?.ToString();
    var afficherFlash = !(ViewData["HideFlash"] is bool masque && masque);
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#70A130" />

    <title>@titreComplet</title>

    <link rel="icon" type="image/x-icon" href="~/Logo/logosocota.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6.5.1/css/all.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css" />

    <style>

        /* =========================================================
           VARIABLES
           ========================================================= */

        :root {
            --socota-green: #8BC53F;
            --socota-green-dark: #70A130;
            --socota-green-light: #a7d866;
            --socota-green-glow: rgba(139, 197, 63, 0.35);

            --socota-black: #101417;
            --socota-dark: #151a1e;
            --socota-dark-2: #1b2126;
            --socota-dark-3: #22292f;

            --light-bg: #f4f6f9;
            --dark-bg: #111518;
            --dark-card: #1c2227;
            --dark-border: #30373d;
            --dark-header: #20272d;

            --text-dark: #1d2429;
            --text-muted: #7b858d;

            --sidebar-width: 258px;
            --sidebar-collapsed-width: 74px;
            --header-height: 60px;
            --footer-height: 32px;
            --brand-height: 76px;

            --app-height: 100vh;
            --page-gutter: 24px;
            --page-height: calc(var(--app-height) - var(--header-height) - var(--footer-height));

            --radius: 12px;
            --radius-sm: 8px;

            --transition-fast: 0.18s cubic-bezier(.4, 0, .2, 1);
            --transition: 0.28s cubic-bezier(.4, 0, .2, 1);
        }

        @@supports (height: 100dvh) {
            :root { --app-height: 100dvh; }
        }


        /* =========================================================
           BASE
           ========================================================= */

        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            width: 100%;
            height: 100%;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
        }

        body {
            --content-left: var(--sidebar-width);

            font-family: "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background-color: var(--light-bg);
            color: var(--text-dark);
            transition: background-color var(--transition), color var(--transition);
        }

        button, input, select, textarea { font-family: inherit; }

        ::selection { background: var(--socota-green); color: #fff; }

        .preload *, .preload *::before, .preload *::after {
            transition: none !important;
        }

        .wrapper {
            position: relative !important;
            width: 100% !important;
            height: var(--app-height) !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
        }


        /* =========================================================
           SIDEBAR
           ========================================================= */

        .main-sidebar {
            --w: var(--sidebar-width);

            position: fixed !important;
            top: 0 !important;
            bottom: 0 !important;
            left: 0 !important;

            width: var(--w) !important;
            min-width: var(--w) !important;
            max-width: var(--w) !important;
            height: auto !important;
            min-height: 0 !important;

            margin: 0 !important;
            padding: 0 !important;

            display: flex !important;
            flex-direction: column;

            z-index: 1040 !important;
            overflow: hidden !important;

            background: linear-gradient(180deg, #14191d 0%, #0d1114 100%) !important;
            border-right: 1px solid rgba(139, 197, 63, 0.08) !important;
            box-shadow: 4px 0 24px rgba(0, 0, 0, 0.18);

            transition: width var(--transition), min-width var(--transition),
                        max-width var(--transition), transform var(--transition);
        }

        /* zone de menu : défilante (menu long / petit écran) mais sans barre visible */
        .main-sidebar .sidebar {
            flex: 1 1 0;
            min-height: 0;
            width: 100%;
            height: auto !important;
            margin: 0 !important;
            padding: 0 0 12px !important;
            overflow-x: hidden !important;
            overflow-y: auto !important;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        .main-sidebar .sidebar::-webkit-scrollbar { display: none; width: 0; height: 0; }


        /* =========================================================
           LOGO + TITRE
           ========================================================= */

        .brand-link {
            position: relative;
            display: flex !important;
            align-items: center;
            flex: 0 0 var(--brand-height);
            width: 100%;
            height: var(--brand-height) !important;
            margin: 0;
            padding: 8px 14px !important;
            overflow: hidden;
            text-decoration: none;
            background: linear-gradient(135deg, #0e1215 0%, #191f24 100%) !important;
            border-bottom: 1px solid rgba(139, 197, 63, 0.14) !important;
            transition: padding var(--transition);
        }

        .brand-link::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 40%;
            height: 2px;
            background: linear-gradient(90deg, var(--socota-green), transparent);
        }

        .brand-link:hover { background: linear-gradient(135deg, #12171b 0%, #1f262c 100%) !important; }

        .brand-link:focus-visible { outline: 2px solid var(--socota-green-light); outline-offset: -3px; }

        .brand-logo-box {
            display: flex !important;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            width: 60px !important;
            height: 60px !important;
            min-width: 60px !important;
            min-height: 60px !important;
            margin: 0 !important;
            padding: 0 !important;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            filter: drop-shadow(0 4px 14px rgba(139, 197, 63, 0.45));
            transition: filter var(--transition), transform var(--transition);
        }

        .brand-link:hover .brand-logo-box {
            filter: drop-shadow(0 6px 20px rgba(139, 197, 63, 0.65));
            transform: scale(1.04);
        }

        .brand-logo-box img {
            display: block !important;
            width: 100% !important;
            height: 100% !important;
            max-width: none !important;
            max-height: none !important;
            margin: 0 !important;
            padding: 0 !important;
            float: none !important;
            object-fit: contain;
            opacity: 1 !important;
            filter: none !important;
            background: transparent !important;
        }

        .brand-title {
            margin-left: 13px !important;
            color: #fff !important;
            font-size: 1.08rem;
            font-weight: 800 !important;
            line-height: 1.15;
            white-space: nowrap;
        }

        .brand-subtitle {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 4px;
            color: #8a979d;
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 1.4px;
            text-transform: uppercase;
        }

        .brand-subtitle::before {
            content: "";
            flex-shrink: 0;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--socota-green);
            box-shadow: 0 0 6px var(--socota-green);
        }


        /* =========================================================
           MENU
           ========================================================= */

        .nav-sidebar {
            width: 100%;
            margin: 0 !important;
            padding: 14px 0 0 !important;
            list-style: none;
        }

        .nav-sidebar-label {
            margin: 10px 0 4px;
            padding: 4px 20px;
            list-style: none;
            color: #6f7b82;
            font-size: 0.64rem;
            font-weight: 700;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .nav-sidebar .nav-item {
            width: 100%;
            margin: 0 0 3px !important;
            padding: 0 10px !important;
        }

        .nav-sidebar .nav-link {
            position: relative;
            display: flex !important;
            align-items: center;
            width: 100%;
            height: 42px !important;
            min-height: 42px;
            margin: 1px 0 !important;
            padding: 0 12px !important;
            overflow: hidden;
            border-radius: var(--radius-sm) !important;
            color: #c4cbcf !important;
            font-size: 0.87rem;
            font-weight: 500;
            text-decoration: none;
            transition: background-color var(--transition-fast), color var(--transition-fast);
        }

        .nav-sidebar .nav-link .nav-icon {
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            flex: 0 0 20px;
            width: 20px !important;
            min-width: 20px;
            height: 20px;
            margin: 0 10px 0 0 !important;
            padding: 0 !important;
            color: #8b959b !important;
            font-size: 0.95rem !important;
            line-height: 1;
            text-align: center;
            transition: color var(--transition-fast);
        }

        .nav-sidebar .nav-link p {
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .nav-sidebar .nav-link.active {
            background: linear-gradient(90deg, var(--socota-green), var(--socota-green-dark)) !important;
            color: #fff !important;
            font-weight: 700;
            box-shadow: 0 4px 14px var(--socota-green-glow);
        }

        .nav-sidebar .nav-link.active .nav-icon { color: #fff !important; }

        .nav-sidebar .nav-link:not(.active):hover {
            background: rgba(139, 197, 63, 0.10) !important;
            color: var(--socota-green) !important;
        }

        .nav-sidebar .nav-link:not(.active):hover .nav-icon { color: var(--socota-green) !important; }

        .nav-sidebar .nav-link:focus-visible {
            outline: 2px solid var(--socota-green-light);
            outline-offset: -2px;
        }


        /* =========================================================
           HEADER
           ========================================================= */

        .main-header.navbar {
            position: fixed !important;
            top: 0 !important;
            left: var(--content-left) !important;
            right: 0 !important;
            width: auto !important;
            height: var(--header-height) !important;
            min-height: var(--header-height) !important;
            margin: 0 !important;
            padding: 0 10px 0 6px !important;

            display: flex !important;
            flex-wrap: nowrap;
            align-items: center;
            gap: 6px;

            z-index: 1030 !important;

            background: linear-gradient(90deg, var(--socota-green), var(--socota-green-dark)) !important;
            border: 0 !important;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.10);

            transition: left var(--transition);
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
            min-width: 0;
        }

        .hdr-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            width: 40px;
            height: 40px;
            padding: 0;
            border: 1px solid transparent;
            border-radius: var(--radius-sm);
            background: transparent;
            color: #fff;
            font-size: 1.05rem;
            line-height: 1;
            text-decoration: none;
            cursor: pointer;
            transition: background-color var(--transition-fast), border-color var(--transition-fast);
        }

        .hdr-btn:hover { background: rgba(255, 255, 255, 0.16); color: #fff; }
        .hdr-btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

        .hdr-btn--outlined {
            border-color: rgba(255, 255, 255, 0.4);
            background: rgba(255, 255, 255, 0.06);
        }

        #sidebarToggle { width: 44px; font-size: 1.15rem; }

        .notification-badge {
            position: absolute;
            top: 2px;
            right: 0;
            display: none;
            align-items: center;
            justify-content: center;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border: 2px solid var(--socota-green-dark);
            border-radius: 999px;
            background: #dc3545;
            color: #fff;
            font-size: 0.62rem;
            font-weight: 800;
            line-height: 1;
            animation: notifPulse 1.8s infinite;
        }

        @@keyframes notifPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.5); }
            50% { box-shadow: 0 0 0 4px rgba(220, 53, 69, 0); }
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 0;
            max-width: 280px;
            padding: 5px 12px 5px 6px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
            transition: background-color var(--transition-fast);
        }

        .user-chip:hover { background: rgba(255, 255, 255, 0.20); }

        .user-avatar {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            width: 27px;
            height: 27px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.92);
            color: var(--socota-green-dark);
            font-size: 0.72rem;
            font-weight: 800;
        }

        .user-chip-name {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 0.82rem;
            font-weight: 700;
        }


        /* =========================================================
           CONTENU 
           ========================================================= */

        .content-wrapper {
            position: fixed !important;
            top: var(--header-height) !important;
            left: var(--content-left) !important;
            right: 0 !important;
            bottom: var(--footer-height) !important;

            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            min-height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;

            background-color: var(--light-bg) !important;

            overflow-x: hidden !important;
            overflow-y: auto !important;

            scrollbar-width: thin;
            scrollbar-color: var(--socota-green) transparent;

            transition: left var(--transition);
        }

        .content-wrapper::-webkit-scrollbar { width: 8px; }
        .content-wrapper::-webkit-scrollbar-track { background: transparent; }
        .content-wrapper::-webkit-scrollbar-thumb { background: var(--socota-green); border-radius: 10px; }

        .content { width: 100%; min-width: 0; padding: 0 !important; }

        /* 12px haut + 12px bas = --page-gutter (24px) */
        .content > .container-fluid {
            width: 100%;
            max-width: none;
            min-width: 0;
            padding: 12px 16px !important;
        }


        /* =========================================================
           MESSAGES 
           ========================================================= */

        .flash-stack {
            position: fixed;
            top: calc(var(--header-height) + 12px);
            right: 16px;
            z-index: 1060;
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: min(440px, calc(100vw - 32px));
            pointer-events: none;
        }

        .flash-stack .alert {
            margin: 0;
            pointer-events: auto;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
        }

        .alert-success {
            background: linear-gradient(135deg, var(--socota-green), var(--socota-green-dark));
            border-color: var(--socota-green);
            color: #fff;
            border-radius: var(--radius);
        }

        .alert-success .btn-close { filter: brightness(0) invert(1); }
        .alert-danger { border-radius: var(--radius); }


        /* =========================================================
           FOOTER
           ========================================================= */

        .main-footer {
            position: fixed !important;
            left: var(--content-left) !important;
            right: 0 !important;
            bottom: 0 !important;
            width: auto !important;
            height: var(--footer-height) !important;
            min-height: var(--footer-height) !important;
            margin: 0 !important;
            padding: 0 16px !important;

            display: flex !important;
            align-items: center;
            justify-content: flex-end;
            gap: 4px;

            z-index: 1030 !important;
            overflow: hidden;
            white-space: nowrap;

            background: transparent !important;
            border: 0 !important;
            box-shadow: none !important;

            color: var(--text-dark);
            font-size: 0.72rem;
            line-height: 1;

            transition: left var(--transition);
        }

        .main-footer strong { color: var(--socota-green-dark); }


        /* =========================================================
           FOND SOMBRE DU MENU MOBILE
           ========================================================= */

        .sidebar-backdrop {
            position: fixed;
            inset: 0;
            z-index: 1035;
            background: rgba(8, 12, 10, 0.55);
            opacity: 0;
            visibility: hidden;
            transition: opacity var(--transition), visibility var(--transition);
        }


        /* =========================================================
           COMPOSANTS SOCOTA
           ========================================================= */

        .card {
            border: 1px solid rgba(0, 0, 0, 0.06);
            border-radius: var(--radius);
            transition: box-shadow var(--transition);
        }

        .card:hover { box-shadow: 0 10px 28px rgba(0, 0, 0, 0.09); }

        .card-header {
            border-top-left-radius: var(--radius);
            border-top-right-radius: var(--radius);
        }

        /* texte foncé : le blanc sur ce vert clair était illisible (contraste ~2:1) */
        .bg-socota {
            background-color: var(--socota-green) !important;
            color: #1f2a14 !important;
        }

        .text-socota { color: var(--socota-green) !important; }
        .border-socota { border-color: var(--socota-green) !important; }

        .btn-socota {
            background: linear-gradient(135deg, var(--socota-green), var(--socota-green-dark));
            border-color: var(--socota-green-dark);
            color: #fff;
            font-weight: 700;
            box-shadow: 0 3px 10px var(--socota-green-glow);
            transition: transform var(--transition-fast), box-shadow var(--transition-fast);
        }

        .btn-socota:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px var(--socota-green-glow);
        }

        .btn-outline-socota {
            background: transparent;
            border: 1.5px solid var(--socota-green);
            color: var(--socota-green-dark);
            font-weight: 600;
            transition: all var(--transition-fast);
        }

        .btn-outline-socota:hover {
            background: var(--socota-green);
            border-color: var(--socota-green);
            color: #fff;
        }


        /* =========================================================
           MENU RÉDUIT (ordinateur uniquement)
           ========================================================= */

        @@media (min-width: 768px) {

            body.sb-collapsed { --content-left: var(--sidebar-collapsed-width); }

            body.sb-collapsed .main-sidebar { --w: var(--sidebar-collapsed-width); }

            body.sb-collapsed .brand-link {
                justify-content: center;
                padding: 8px 6px !important;
            }

            body.sb-collapsed .brand-logo-box {
                width: 54px !important;
                height: 54px !important;
                min-width: 54px !important;
                min-height: 54px !important;
            }

            body.sb-collapsed .brand-title { display: none !important; }

            body.sb-collapsed .nav-sidebar { padding-top: 12px !important; }

            /* les titres de section deviennent un simple trait séparateur */
            body.sb-collapsed .nav-sidebar-label {
                height: 1px;
                margin: 10px 16px;
                padding: 0;
                overflow: hidden;
                font-size: 0;
                background: rgba(255, 255, 255, 0.08);
            }

            body.sb-collapsed .nav-sidebar .nav-item { padding: 0 7px !important; }

            body.sb-collapsed .nav-sidebar .nav-link {
                justify-content: center;
                padding: 0 !important;
            }

            body.sb-collapsed .nav-sidebar .nav-link .nav-icon { margin: 0 !important; }

            body.sb-collapsed .nav-sidebar .nav-link p { display: none !important; }
        }


        /* =========================================================
           MODE SOMBRE
           ========================================================= */

        body[data-bs-theme="dark"] {
            background-color: var(--dark-bg);
            color: #e0e0e0;
        }

        body[data-bs-theme="dark"] .content-wrapper { background-color: var(--dark-bg) !important; }
        body[data-bs-theme="dark"] .main-footer { color: #e0e0e0; }
        body[data-bs-theme="dark"] .main-footer strong { color: var(--socota-green-light); }

        body[data-bs-theme="dark"] .card {
            background-color: var(--dark-card);
            color: #e0e0e0;
            border-color: var(--dark-border);
        }

        body[data-bs-theme="dark"] .card-header {
            background-color: var(--dark-header);
            color: #e0e0e0;
            border-bottom-color: var(--dark-border);
        }

        body[data-bs-theme="dark"] .modal-content,
        body[data-bs-theme="dark"] .dropdown-menu {
            background-color: var(--dark-card);
            color: #e0e0e0;
            border-color: var(--dark-border);
        }

        body[data-bs-theme="dark"] .bg-light { background-color: var(--dark-header) !important; }
        body[data-bs-theme="dark"] .table { color: #e0e0e0; }
        body[data-bs-theme="dark"] .table-light { background-color: var(--dark-header); color: #e0e0e0; }

        body[data-bs-theme="dark"] .form-control,
        body[data-bs-theme="dark"] .form-select {
            background-color: var(--dark-card);
            color: #e0e0e0;
            border-color: var(--dark-border);
        }

        body[data-bs-theme="dark"] .form-control:focus,
        body[data-bs-theme="dark"] .form-select:focus {
            border-color: var(--socota-green);
            box-shadow: 0 0 0 0.2rem rgba(139, 197, 63, 0.2);
        }

        body[data-bs-theme="dark"] .text-muted { color: #a0a0a0 !important; }
        body[data-bs-theme="dark"] .text-dark { color: #e0e0e0 !important; }
        body[data-bs-theme="dark"] .border { border-color: var(--dark-border) !important; }

        body[data-bs-theme="dark"] .list-group-item {
            background-color: var(--dark-card);
            border-color: var(--dark-border);
            color: #e0e0e0;
        }

        body[data-bs-theme="dark"] .btn-outline-secondary { color: #d0d0d0; border-color: #666; }
        body[data-bs-theme="dark"] .btn-outline-secondary:hover { background-color: #555; color: #fff; }


        /* =========================================================
           RESPONSIVE
           ========================================================= */

        @@media (max-width: 991.98px) {
            .user-chip { padding-right: 6px; }
            .user-chip-name { display: none; }
        }

        @@media (max-width: 767.98px) {

            body { --content-left: 0px; }

            .main-sidebar {
                --w: var(--sidebar-width);
                transform: translateX(-100%);
                box-shadow: none;
            }

            body.sb-open .main-sidebar {
                transform: translateX(0);
                box-shadow: 8px 0 32px rgba(0, 0, 0, 0.35);
            }

            body.sb-open .sidebar-backdrop { opacity: 1; visibility: visible; }

            .content > .container-fluid { padding: 10px !important; }
            .main-footer span { display: none; }
        }

        @@media (max-width: 575.98px) {
            .main-header.navbar { padding: 0 6px 0 2px !important; }
            .hdr-btn { width: 36px; height: 36px; }
            #sidebarToggle { width: 40px; }
            .main-footer { font-size: 0.64rem; }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
            }
        }

    </style>
</head>

<body class="preload" data-bs-theme="light">

    <script>
        (function () {
            try {
                var b = document.body;
                b.setAttribute("data-bs-theme", localStorage.getItem("theme") === "dark" ? "dark" : "light");
                if (window.matchMedia("(min-width: 768px)").matches &&
                    localStorage.getItem("sidebarCollapsed") === "true") {
