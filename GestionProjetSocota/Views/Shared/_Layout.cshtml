<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - GestionProjetSocota</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">

    <style>
        :root {
            --socota-green: #228B22;
            --socota-green-dark: #155D15;
        }
        .brand-link, .nav-sidebar .nav-link.active { background-color: var(--socota-green) !important; }
        .main-header.navbar { background-color: var(--socota-green) !important; }
        .btn-socota { background-color: var(--socota-green); color: #fff; border: none; }
        .btn-socota:hover { background-color: var(--socota-green-dark); color: #fff; }

        body[data-bs-theme="dark"] {
            background-color: #1a1d21;
            color: #e0e0e0;
        }
        body[data-bs-theme="dark"] .content-wrapper {
            background-color: #1a1d21;
        }
        body[data-bs-theme="dark"] .card {
            background-color: #2b2f33;
            color: #e0e0e0;
            border-color: #3a3f44;
        }
        body[data-bs-theme="dark"] .table {
            color: #e0e0e0;
        }
        body[data-bs-theme="dark"] .card-header,
        body[data-bs-theme="dark"] .table-light {
            background-color: #33383d;
            color: #e0e0e0;
        }
        body[data-bs-theme="dark"] .form-control,
        body[data-bs-theme="dark"] .form-select {
            background-color: #2b2f33;
            color: #e0e0e0;
            border-color: #3a3f44;
        }
        body[data-bs-theme="dark"] .text-muted {
            color: #a0a0a0 !important;
        }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed" data-bs-theme="light">
<div class="wrapper">

    <!-- Navbar -->
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
        </ul>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <button id="toggleDarkMode" class="btn btn-sm btn-outline-light" type="button">
                    <i class="fas fa-moon"></i>
                </button>
            </li>
            <li class="nav-item">
                <span class="nav-link text-white">@User.Identity?.Name</span>
            </li>
        </ul>
    </nav>

    <!-- Sidebar -->
    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a href="/" class="brand-link">
            <span class="brand-text font-weight-light">&nbsp;Socota PMO</span>
        </a>

        <div class="sidebar">
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                    <li class="nav-item"><a href="/Projet" class="nav-link"><i class="nav-icon fas fa-list"></i><p>Projets</p></a></li>
                    <li class="nav-item"><a href="/Projet/Kanban" class="nav-link"><i class="nav-icon fas fa-columns"></i><p>Kanban</p></a></li>
                    <li class="nav-item"><a href="/Projet/Roadmap" class="nav-link"><i class="nav-icon fas fa-map"></i><p>Roadmap</p></a></li>
                    <li class="nav-item"><a href="/Projet/Gantt" class="nav-link"><i class="nav-icon fas fa-chart-line"></i><p>Gantt</p></a></li>
                    <li class="nav-item"><a href="/Projet/Dashboard" class="nav-link"><i class="nav-icon fas fa-chart-bar"></i><p>Dashboard Exécutif</p></a></li>
                    <li class="nav-item"><a href="/Projet/DashboardComex" class="nav-link"><i class="nav-icon fas fa-chart-pie"></i><p>Dashboard COMEX</p></a></li>
                    <li class="nav-item"><a href="/Projet/DashboardItManager" class="nav-link"><i class="nav-icon fas fa-users-cog"></i><p>Dashboard IT Manager</p></a></li>
                    <li class="nav-item"><a href="/Projet/Recherche" class="nav-link"><i class="nav-icon fas fa-search"></i><p>Recherche</p></a></li>
                    <li class="nav-item"><a href="/Projet/Create" class="nav-link"><i class="nav-icon fas fa-plus"></i><p>Nouveau projet</p></a></li>
                </ul>
            </nav>
        </div>
    </aside>

    <!-- Content -->
    <div class="content-wrapper">
        <div class="content">
            <div class="container-fluid pt-3">
                @if (TempData["Succes"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Succes"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
                @RenderBody()
            </div>
        </div>
    </div>

    <footer class="main-footer">
        <strong>GestionProjetSocota</strong> — PMO Digital Platform
    </footer>
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const boutonTheme = document.getElementById('toggleDarkMode');
        const themeActuel = localStorage.getItem('theme') || 'light';
        document.body.setAttribute('data-bs-theme', themeActuel);

        boutonTheme.addEventListener('click', () => {
            const nouveauTheme = document.body.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
            document.body.setAttribute('data-bs-theme', nouveauTheme);
            localStorage.setItem('theme', nouveauTheme);
        });
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>