<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - GestionProjetSocota</title>

    <link rel="icon" type="image/png" href="~/Logo/logosocota.ico" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css" />

    <style>
            :root {
                --socota-green: #8BC53F;
                --socota-green-dark: #70A130;

                --light-bg: #f4f6f9;
                --dark-bg: #1a1d21;
                --dark-card: #2b2f33;
                --dark-border: #3a3f44;
                --dark-header: #33383d;

                --transition: 0.2s ease;
                --radius: 8px;
            }


            body {
                background-color: var(--light-bg);
            }


            /* =========================================================
                   BRAND
                   ========================================================= */

            .brand-link {
                background-color: var(--socota-green);
                border-bottom: 0;
            }

            .brand-link:hover {
                background-color: var(--socota-green-dark);
            }


            /* =========================================================
                   HEADER
                   ========================================================= */

            .main-header.navbar {
                background-color: var(--socota-green);
                border-bottom: 0;
            }

            .main-header .nav-link {
                color: #fff;
            }

            .main-header .nav-link:hover {
                color: #fff;
                opacity: 0.85;
            }


            /* =========================================================
                   SIDEBAR
                   ========================================================= */

            .nav-sidebar .nav-link {
                transition:
                    background-color var(--transition),
                    color var(--transition),
                    transform var(--transition);
            }


            /* MENU ACTIF */
            
            .nav-sidebar .nav-link.active,
            .sidebar-dark-primary .nav-sidebar>.nav-item>.nav-link.active,
            .sidebar-dark-success .nav-sidebar>.nav-item>.nav-link.active {
                background-color: #8BC53F !important;
                color: #fff !important;
                font-weight: 600;
                box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
            }

            .nav-sidebar .nav-link.active .nav-icon {
                color: #fff;
            }


            /* Petit effet au survol */

            .nav-sidebar .nav-link:not(.active):hover {
                background-color: rgba(139, 197, 63, 0.15);
                color: var(--socota-green);
            }


            /* Le menu actif reste vert même avec la souris dessus */

            .nav-sidebar .nav-link.active:hover {
                background-color: var(--socota-green);
                color: #fff;
            }


            /* =========================================================
                   AUTRES STYLES
                   ========================================================= */

            .bg-socota {
                background-color: var(--socota-green);
                color: #fff;
            }

            .text-socota {
                color: var(--socota-green);
            }

            .border-socota {
                border-color: var(--socota-green);
            }


            .btn-socota {
                background-color: var(--socota-green);
                border-color: var(--socota-green);
                color: #fff;

                transition:
                    background-color var(--transition),
                    border-color var(--transition),
                    transform var(--transition);
            }

            .btn-socota:hover {
                background-color: var(--socota-green-dark);
                border-color: var(--socota-green-dark);
                color: #fff;
                transform: translateY(-1px);
            }


            .btn-outline-socota {
                background-color: transparent;
                border: 1px solid var(--socota-green);
                color: var(--socota-green);

                transition: all var(--transition);
            }

            .btn-outline-socota:hover {
                background-color: var(--socota-green);
                border-color: var(--socota-green);
                color: #fff;
            }


            .alert-success {
                background-color: var(--socota-green);
                border-color: var(--socota-green);
                color: #fff;
                border-radius: var(--radius);
            }

            .alert-success .btn-close {
                filter: brightness(0) invert(1);
            }


            .risk-low,
            .badge-risk-low,
            .bg-risk-low {
                background-color: var(--socota-green);
                color: #fff;
            }

            .text-risk-low {
                color: var(--socota-green);
            }

            .border-risk-low {
                border-color: var(--socota-green);
            }


            .content-wrapper {
                min-height: calc(100vh - 57px);
            }

            .content {
                padding-bottom: 20px;
            }


            .card {
                border-radius: var(--radius);

                transition:
                    box-shadow var(--transition),
                    transform var(--transition);
            }

            .card:hover {
                box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
            }


            .card-header {
                border-top-left-radius: var(--radius);
                border-top-right-radius: var(--radius);
            }


            .main-footer {
                background-color: #fff;
                border-top: 1px solid #dee2e6;
            }


            #toggleDarkMode {
                width: 36px;
                height: 32px;

                display: inline-flex;
                align-items: center;
                justify-content: center;
            }


            /* =========================================================
                   DARK MODE
                   ========================================================= */

            body[data-bs-theme="dark"] {
                background-color: var(--dark-bg);
                color: #e0e0e0;
            }

            body[data-bs-theme="dark"] .content-wrapper {
                background-color: var(--dark-bg);
            }

            body[data-bs-theme="dark"] .main-footer {
                background-color: var(--dark-card);
                border-top-color: var(--dark-border);
                color: #e0e0e0;
            }

            body[data-bs-theme="dark"] .card {
                background-color: var(--dark-card);
                color: #e0e0e0;
                border-color: var(--dark-border);
            }

            body[data-bs-theme="dark"] .card-header {
                background-color: var(--dark-header);
                color: #e0e0e0;
                border-bottom-color: var(--dark-border);
            }

            body[data-bs-theme="dark"] .table {
                color: #e0e0e0;
            }

            body[data-bs-theme="dark"] .table-light {
                background-color: var(--dark-header);
                color: #e0e0e0;
            }

            body[data-bs-theme="dark"] .form-control,
            body[data-bs-theme="dark"] .form-select {
                background-color: var(--dark-card);
                color: #e0e0e0;
                border-color: var(--dark-border);
            }

            body[data-bs-theme="dark"] .form-control:focus,
            body[data-bs-theme="dark"] .form-select:focus {
                border-color: var(--socota-green);
                box-shadow: 0 0 0 0.2rem rgba(139, 197, 63, 0.2);
            }

            body[data-bs-theme="dark"] .text-muted {
                color: #a0a0a0;
            }

            body[data-bs-theme="dark"] .border {
                border-color: var(--dark-border);
            }

            body[data-bs-theme="dark"] .list-group-item {
                border-color: var(--dark-border);
                color: #e0e0e0;
            }

            body[data-bs-theme="dark"] .text-dark {
                color: #e0e0e0;
            }

            body[data-bs-theme="dark"] .btn-outline-secondary {
                color: #d0d0d0;
                border-color: #666;
            }

            body[data-bs-theme="dark"] .btn-outline-secondary:hover {
                background-color: #555;
                color: #fff;
            }


            /* =========================================================
                   NOTIFICATIONS
                   ========================================================= */

            #notificationBadge {
                top: 2px;
                right: -2px;

                font-size: 0.65rem;
                min-width: 18px;
                height: 18px;

                padding: 2px 5px;
                border-radius: 50%;

                display: none;
            }

            .notification-link {
                position: relative;
            }
    </style>

</head>


<body class="hold-transition sidebar-mini layout-fixed" data-bs-theme="light">

    <div class="wrapper">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <nav class="main-header navbar navbar-expand">

            <ul class="navbar-nav">

                <li class="nav-item">

                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"
                       aria-label="Ouvrir ou fermer le menu">

                        <i class="fas fa-bars"></i>

                    </a>

                </li>

            </ul>


            <ul class="navbar-nav ml-auto align-items-center">

                <li class="nav-item me-2">

                    <button id="toggleDarkMode" class="btn btn-sm btn-outline-light" type="button"
                            aria-label="Changer de thème">

                        <i class="fas fa-moon"></i>

                    </button>

                </li>


                <li class="nav-item me-2">

                    <a href="/Notification" class="nav-link text-white position-relative notification-link"
                       title="Notifications" aria-label="Notifications">

                        <i class="fas fa-bell"></i>

                        <span id="notificationBadge" class="badge bg-danger position-absolute">

                            0

                        </span>

                    </a>

                </li>


                <li class="nav-item">

                    <span class="nav-link text-white">

                        <i class="fas fa-user me-1"></i>

                        @User.Identity?.Name

                    </span>

                </li>

            </ul>

        </nav>



        <!-- =====================================================
             SIDEBAR
             ===================================================== -->

        <aside class="main-sidebar sidebar-dark-success elevation-4">


            <a href="/" class="brand-link d-flex align-items-center">

                <img src="~/Logo/logosocota.jfif" alt="SOCOTA" class="brand-image"
                     style="height: 35px; width: auto; object-fit: contain;" />

                <span class="brand-text font-weight-light ms-2">
                    Socota PMO
                </span>

            </a>


            <div class="sidebar">

                <nav class="mt-2">

                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">


                        <!-- =================================================
                             PROJETS
                             ================================================= -->

                        <li class="nav-item">

                            <a href="/Projet" class="nav-link @(Context.Request.Path == "/Projet" ? "active" : "")">

                                <i class="nav-icon fas fa-list"></i>

                                <p>Projets</p>

                            </a>

                        </li>


                        <!-- =================================================
                             KANBAN
                             ================================================= -->

                        <li class="nav-item">

                            <a href="/Projet/Kanban"
                               class="nav-link @(Context.Request.Path == "/Projet/Kanban" ? "active" : "")">

                                <i class="nav-icon fas fa-columns"></i>

                                <p>Kanban</p>

                            </a>

                        </li>


                        <!-- =================================================
                             ROADMAP
                             ================================================= -->

                        <li class="nav-item">

                            <a href="/Projet/Roadmap"
                               class="nav-link @(Context.Request.Path == "/Projet/Roadmap" ? "active" : "")">

                                <i class="nav-icon fas fa-map"></i>

                                <p>Roadmap</p>

                            </a>

                        </li>


                        <!-- =================================================
                             GANTT
                             ================================================= -->

                        <li class="nav-item">

                            <a href="/Projet/Gantt"
                               class="nav-link @(Context.Request.Path == "/Projet/Gantt" ? "active" : "")">

                                <i class="nav-icon fas fa-chart-line"></i>

                                <p>Gantt</p>

                            </a>

                        </li>


                        <!-- =================================================
                             DASHBOARD EXECUTIF
                             ================================================= -->

                        <li class="nav-item">

                            <a href="/Projet/Dashboard"
                               class="nav-link @(Context.Request.Path == "/Projet/Dashboard" ? "active" : "")">

                                <i class="nav-icon fas fa-chart-bar"></i>

                                <p>Dashboard Exécutif</p>

                            </a>

                        </li>


                        <!-- =================================================
                             DASHBOARD COMEX
                             ================================================= -->

                        <li class="nav-item">

                            <a href="/Projet/DashboardComex"
                               class="nav-link @(Context.Request.Path == "/Projet/DashboardComex" ? "active" : "")">

                                <i class="nav-icon fas fa-chart-pie"></i>

                                <p>Dashboard COMEX</p>

                            </a>

                        </li>


                        <!-- =================================================
                             DASHBOARD IT MANAGER
                             ================================================= -->

                        <li class="nav-item">

                            <a href="/Projet/DashboardItManager"
                               class="nav-link @(Context.Request.Path == "/Projet/DashboardItManager" ? "active" : "")">

                                <i class="nav-icon fas fa-users-cog"></i>

                                <p>Dashboard IT Manager</p>

                            </a>

                        </li>


                        <!-- =================================================
                             RECHERCHE
                             ================================================= -->

                        <li class="nav-item">

                            <a href="/Projet/Recherche"
                               class="nav-link @(Context.Request.Path == "/Projet/Recherche" ? "active" : "")">

                                <i class="nav-icon fas fa-search"></i>

                                <p>Recherche</p>

                            </a>

                        </li>


                        <!-- =================================================
                             NOUVEAU PROJET
                             ================================================= -->

                        <li class="nav-item">

                            <a href="/Projet/Create"
                               class="nav-link @(Context.Request.Path == "/Projet/Create" ? "active" : "")">

                                <i class="nav-icon fas fa-plus"></i>

                                <p>Nouveau projet</p>

                            </a>

                        </li>


                        <!-- =================================================
                             IMPORT EXCEL
                             ================================================= -->

                        <li class="nav-item">

                            <a href="/Projet/ImporterExcel"
                               class="nav-link @(Context.Request.Path == "/Projet/ImporterExcel" ? "active" : "")">

                                <i class="nav-icon fas fa-file-excel"></i>

                                <p>Importer Excel</p>

                            </a>

                        </li>


                    </ul>

                </nav>

            </div>

        </aside>



        <!-- =====================================================
             CONTENU
             ===================================================== -->

        <div class="content-wrapper">

            <div class="content">

                <div class="container-fluid pt-3">


                    <!-- MESSAGE DE SUCCÈS -->

                    @if (TempData["Succes"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">

                            <i class="fas fa-check-circle me-1"></i>

                            @TempData["Succes"]

                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer">
                            </button>

                        </div>
                    }


                    <!-- MESSAGE D'ERREUR -->

                    @if (TempData["Erreur"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">

                            <i class="fas fa-exclamation-circle me-1"></i>

                            @TempData["Erreur"]

                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer">
                            </button>

                        </div>
                    }


                    @RenderBody()

                </div>

            </div>

        </div>



        <!-- =====================================================
             FOOTER
             ===================================================== -->

        <footer class="main-footer">

            <strong>GestionProjetSocota</strong>

            <span class="ms-1">
                — PMO Digital Platform
            </span>

        </footer>


    </div>



    <!-- =========================================================
         SCRIPTS
         ========================================================= -->

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>



    <!-- =========================================================
         MODE SOMBRE
         ========================================================= -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

        const themeButton =
        document.getElementById("toggleDarkMode");

        const themeIcon =
        themeButton.querySelector("i");

        const savedTheme =
        localStorage.getItem("theme") || "light";

        applyTheme(savedTheme);


        themeButton.addEventListener("click", function () {

        const currentTheme =
        document.body.getAttribute("data-bs-theme");

        const newTheme =
        currentTheme === "dark"
        ? "light"
        : "dark";

        applyTheme(newTheme);

        localStorage.setItem(
        "theme",
        newTheme
        );

        });


        function applyTheme(theme) {

        document.body.setAttribute(
        "data-bs-theme",
        theme
        );

        if (theme === "dark") {

        themeIcon.classList.remove("fa-moon");

        themeIcon.classList.add("fa-sun");

        }
        else {

        themeIcon.classList.remove("fa-sun");

        themeIcon.classList.add("fa-moon");

        }

        }

        });

    </script>



    <!-- =========================================================
         NOTIFICATIONS
         ========================================================= -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

        async function chargerNombreNotifications() {

        try {

        const response =
        await fetch("/Notification/NombreNonLues");


        if (!response.ok) {

        console.error(
        "Erreur HTTP notifications :",
        response.status
        );

        return;

        }


        const nombre =
        await response.json();


        const badge =
        document.getElementById(
        "notificationBadge"
        );


        if (!badge) {

        return;

        }


        if (nombre > 0) {

        badge.textContent =
        nombre;

        badge.style.display =
        "block";

        }
        else {

        badge.textContent =
        "0";

        badge.style.display =
        "none";

        }

        }
        catch (error) {

        console.error(
        "Erreur lors du chargement des notifications :",
        error
        );

        }

        }


        chargerNombreNotifications();


        setInterval(
        chargerNombreNotifications,
        30000
        );

        });

    </script>



    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>