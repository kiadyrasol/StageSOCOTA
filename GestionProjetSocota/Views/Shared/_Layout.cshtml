    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const body = document.body;
            const desktop = window.matchMedia("(min-width: 768px)");

            const toggle = document.getElementById("sidebarToggle");
            const backdrop = document.getElementById("sidebarBackdrop");
            const themeBtn = document.getElementById("toggleDarkMode");

            const store = {
                get: function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
                set: function (k, v) { try { localStorage.setItem(k, v); } catch (e) { } }
            };

            /* =====================================================
               MENU : réduit sur ordinateur / tiroir sur mobile
               ===================================================== */

            function syncAria() {
                if (!toggle) { return; }
                const ouvert = desktop.matches
                    ? !body.classList.contains("sb-collapsed")
                    : body.classList.contains("sb-open");
                toggle.setAttribute("aria-expanded", String(ouvert));
            }

            function fermerTiroir() {
                body.classList.remove("sb-open");
                syncAria();
            }

            if (toggle) {
                toggle.addEventListener("click", function () {
                    if (desktop.matches) {
                        body.classList.toggle("sb-collapsed");
                        store.set("sidebarCollapsed", body.classList.contains("sb-collapsed"));
                    } else {
                        body.classList.toggle("sb-open");
                    }
                    syncAria();
                });
            }

            if (backdrop) { backdrop.addEventListener("click", fermerTiroir); }

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") { fermerTiroir(); }
            });

            desktop.addEventListener("change", function () {
                if (desktop.matches) {
                    body.classList.remove("sb-open");
                    body.classList.toggle("sb-collapsed", store.get("sidebarCollapsed") === "true");
                } else {
                    body.classList.remove("sb-collapsed");
                }
                syncAria();
            });

            syncAria();

            /* =====================================================
               MODE SOMBRE
               ===================================================== */

            function appliquerTheme(theme) {
                body.setAttribute("data-bs-theme", theme);

                if (!themeBtn) { return; }

                const icone = themeBtn.querySelector("i");
                if (icone) {
                    icone.classList.toggle("fa-sun", theme === "dark");
                    icone.classList.toggle("fa-moon", theme !== "dark");
                }
                themeBtn.setAttribute("aria-pressed", String(theme === "dark"));
            }

            appliquerTheme(body.getAttribute("data-bs-theme") || "light");

            if (themeBtn) {
                themeBtn.addEventListener("click", function () {
                    const suivant = body.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
                    appliquerTheme(suivant);
                    store.set("theme", suivant);
                });
            }

            const badge = document.getElementById("notificationBadge");
            const lien = document.getElementById("notificationLink");

            async function chargerNotifications() {

                if (!badge || document.hidden) { return; }

                try {
                    const reponse = await fetch("/Notification/NombreNonLues", {
                        headers: { "Accept": "application/json" },
                        cache: "no-store"
                    });

                    if (!reponse.ok) { return; }

                    const nombre = Number(await reponse.json()) || 0;

                    if (nombre > 0) {
                        badge.textContent = nombre > 99 ? "99+" : String(nombre);
                        badge.style.display = "inline-flex";
                    } else {
                        badge.textContent = "0";
                        badge.style.display = "none";
                    }

                    if (lien) {
                        lien.setAttribute("aria-label",
                            nombre > 0 ? "Notifications (" + nombre + " non lues)" : "Notifications");
                    }

                } catch (erreur) {
                    console.error("Erreur notifications :", erreur);
                }
            }

            chargerNotifications();
            setInterval(chargerNotifications, 30000);

            document.addEventListener("visibilitychange", function () {
                if (!document.hidden) { chargerNotifications(); }
            });

            document.querySelectorAll(".flash-stack .alert[data-autohide]").forEach(function (el) {
                const delai = Number(el.dataset.autohide) || 6000;

                setTimeout(function () {
                    if (document.body.contains(el)) {
                        bootstrap.Alert.getOrCreateInstance(el).close();
                    }
                }, delai);
            });

            window.addEventListener("load", function () {
                requestAnimationFrame(function () { body.classList.remove("preload"); });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>