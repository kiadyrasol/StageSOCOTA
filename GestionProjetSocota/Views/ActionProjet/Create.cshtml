@model GestionProjetSocota.ViewModels.ActionCreateViewModel

<h1 class="h3 mb-3">Créer une action</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="ProjetId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Responsable</label>
                <select asp-for="ResponsableId" asp-items="@(new SelectList(Model.UtilisateursDisponibles, "Id", "Nom"))" class="form-select">
                    <option value="">Choisir</option>
                </select>
                <span asp-validation-for="ResponsableId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Date d'échéance</label>
                <input asp-for="DateEcheance" type="date" class="form-control" />
                <span asp-validation-for="DateEcheance" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-socota"><i class="fas fa-plus"></i> Créer l'action</button>
        </form>
    </div>
</div>