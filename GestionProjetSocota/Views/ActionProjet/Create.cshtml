@model GestionProjetSocota.ViewModels.ActionCreateViewModel

<div style="padding:20px; max-width:500px;">
    <h2 style="color:#155D15;">Créer une action</h2>

    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="ProjetId" />
        <div asp-validation-summary="ModelOnly" style="color:red; font-size:13px; margin-bottom:12px;"></div>

        <label>Description</label>
        <textarea asp-for="Description" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px; min-height:70px;"></textarea>
        <span asp-validation-for="Description" style="color:red; font-size:12px;"></span>

        <label style="display:block; margin-top:10px;">Responsable</label>
        <select asp-for="ResponsableId" asp-items="@(new SelectList(Model.UtilisateursDisponibles, "Id", "Nom"))" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;">
            <option value="">-- Choisir --</option>
        </select>
        <span asp-validation-for="ResponsableId" style="color:red; font-size:12px;"></span>

        <label style="display:block; margin-top:10px;">Date d'échéance</label>
        <input asp-for="DateEcheance" type="date" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;" />
        <span asp-validation-for="DateEcheance" style="color:red; font-size:12px;"></span>

        <button type="submit" style="margin-top:18px; width:100%; padding:10px; border:none; border-radius:8px; background:#228B22; color:#fff; font-weight:600; font-size:13px; cursor:pointer;">Créer l'action</button>
    </form>
</div>