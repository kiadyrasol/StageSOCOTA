@model GestionProjetSocota.ViewModels.RFCCreateViewModel

<div style="padding:20px; max-width:600px;">
    <h2 style="color:#155D15;">Créer un RFC</h2>
    <p style="color:#5F5E5A; font-size:13px;">Pour le projet : <b>@ViewBag.ProjetNom</b></p>

    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="ProjetId" />
        <div asp-validation-summary="ModelOnly" style="color:red; font-size:13px; margin-bottom:12px;"></div>

        <label>Business Case</label>
        <textarea asp-for="BusinessCase" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px; min-height:80px;"></textarea>
        <span asp-validation-for="BusinessCase" style="color:red; font-size:12px;"></span>

        <label style="display:block; margin-top:10px;">ROI estimé</label>
        <input asp-for="RoiEstime" type="number" step="0.01" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;" />

        <label style="display:block; margin-top:10px;">Gains attendus</label>
        <textarea asp-for="GainsAttendus" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px; min-height:60px;"></textarea>

        <label style="display:block; margin-top:10px;">Champion</label>
        <select asp-for="ChampionId" asp-items="@(new SelectList(Model.UtilisateursDisponibles, "Id", "Nom"))" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;">
            <option value="">Choisir</option>
        </select>
        <span asp-validation-for="ChampionId" style="color:red; font-size:12px;"></span>

        <label style="display:block; margin-top:10px;">Sponsor</label>
        <select asp-for="SponsorId" asp-items="@(new SelectList(Model.UtilisateursDisponibles, "Id", "Nom"))" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;">
            <option value="">Choisir</option>
        </select>
        <span asp-validation-for="SponsorId" style="color:red; font-size:12px;"></span>

        <label style="display:block; margin-top:10px;">Priorité</label>
        <input asp-for="Priorite" type="text" style="width:100%; padding:9px 11px; border:1px solid #E1E0DB; border-radius:8px; font-size:13px;" />

        <button type="submit" style="margin-top:18px; width:100%; padding:10px; border:none; border-radius:8px; background:#228B22; color:#fff; font-weight:600; font-size:13px; cursor:pointer;">Créer le RFC</button>
    </form>
</div>