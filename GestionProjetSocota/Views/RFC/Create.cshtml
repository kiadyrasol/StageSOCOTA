@model GestionProjetSocota.ViewModels.RFCCreateViewModel

<h1 class="h3 mb-3">Créer un RFC</h1>
<p class="text-muted small mb-3">Pour le projet : <b>@ViewBag.ProjetNom</b></p>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="ProjetId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label class="form-label">Business Case</label>
                <textarea asp-for="BusinessCase" class="form-control" rows="3"></textarea>
                <span asp-validation-for="BusinessCase" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">ROI estimé</label>
                <input asp-for="RoiEstime" type="number" step="0.01" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Gains attendus</label>
                <textarea asp-for="GainsAttendus" class="form-control" rows="2"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Champion</label>
                    <select asp-for="ChampionId" asp-items="@(new SelectList(Model.UtilisateursDisponibles, "Id", "Nom"))" class="form-select">
                        <option value="">Choisir</option>
                    </select>
                    <span asp-validation-for="ChampionId" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Sponsor</label>
                    <select asp-for="SponsorId" asp-items="@(new SelectList(Model.UtilisateursDisponibles, "Id", "Nom"))" class="form-select">
                        <option value="">Choisir</option>
                    </select>
                    <span asp-validation-for="SponsorId" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Priorité</label>
                <input asp-for="Priorite" type="text" class="form-control" />
            </div>

            <button type="submit" class="btn btn-socota"><i class="fas fa-plus"></i> Créer le RFC</button>
        </form>
    </div>
</div>